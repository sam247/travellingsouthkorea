2:["$","div",null,{"className":"min-h-screen bg-background","children":["$","div",null,{"className":"pt-24 sm:pt-28 max-w-4xl mx-auto px-4 sm:px-6","children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://travellingsouthkorea.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Mina Park\"}]}"}}],["$","$L9",null,{"children":["$","$La",null,{"children":[["$","$Lb","0",{"children":[false,["$","$Lc",null,{"asChild":true,"children":["$","$L7",null,{"href":"/","children":"Home"}]}]]}],["$","$Lb","1",{"children":[["$","$Ld",null,{}],["$","$Le",null,{"children":"Mina Park"}]]}]]}]}]],["$","div",null,{"className":"mt-8 flex flex-col sm:flex-row items-start gap-6","children":[["$","div",null,{"className":"w-24 h-24 sm:w-32 sm:h-32 rounded-full overflow-hidden flex-shrink-0","children":["$","$Lf",null,{"src":"https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=400&q=80","alt":"Mina Park","width":128,"height":128,"className":"w-full h-full object-cover"}]}],["$","div",null,{"children":[["$","h1",null,{"className":"text-2xl sm:text-3xl font-bold text-foreground","children":"Mina Park"}],["$","p",null,{"className":"text-sm text-primary font-medium mt-1","children":"Busan, South Korea"}],["$","p",null,{"className":"text-base text-muted-foreground mt-3 leading-relaxed max-w-lg","children":"Travel writer and photographer based in Busan. Mina covers Korea's food scene, coastal destinations and off-the-beaten-path experiences. Her work focuses on the quieter, more beautiful side of Korean travel."}],["$","div",null,{"className":"flex flex-wrap gap-2 mt-4","children":[["$","span","Food",{"className":"text-xs font-medium px-2.5 py-1 rounded-full bg-secondary text-muted-foreground","children":"Food"}],["$","span","Cafes",{"className":"text-xs font-medium px-2.5 py-1 rounded-full bg-secondary text-muted-foreground","children":"Cafes"}],["$","span","Nature",{"className":"text-xs font-medium px-2.5 py-1 rounded-full bg-secondary text-muted-foreground","children":"Nature"}],["$","span","Photography",{"className":"text-xs font-medium px-2.5 py-1 rounded-full bg-secondary text-muted-foreground","children":"Photography"}]]}]]}]]}],["$","section",null,{"className":"py-10 sm:py-14","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-bold text-foreground mb-6","children":["Guides by ","Mina Park"]}],["$","div",null,{"className":"grid grid-cols-1 sm:grid-cols-2 gap-5","children":[["$","$L10","best-street-food-myeongdong",{"guide":{"slug":"best-street-food-myeongdong","title":"Best Street Food In Myeongdong","city":"seoul","category":"food","neighbourhood":"Myeongdong","neighbourhoodSlug":"myeongdong","priceRange":"₩","nearestMetro":"Myeongdong (Line 4)","openingHours":"11 AM – 10 PM","image":"https://images.unsplash.com/photo-1498654896293-37aacf113fd9?w=1200&q=80","summary":"Tteokbokki, hotteok, tornado potatoes — everything you need to eat on Myeongdong's food streets.","intro":"Myeongdong's main streets transform into an open-air food market every afternoon. Vendors line both sides selling everything from freshly grilled skewers to towering soft-serve ice cream. Come hungry.","venues":[{"name":"Myeongdong Kyoja","image":"https://images.unsplash.com/photo-1590301157890-4810ed352733?w=600&q=80","description":"A Myeongdong institution serving handmade kalguksu (knife-cut noodles) since 1966. The broth is rich and deeply savoury.","address":"29 Myeongdong 10-gil, Jung-gu","tip":"There's always a queue but it moves fast. The mandu (dumplings) are a must-order alongside the noodles.","priceLevel":"₩"}],"relatedSlugs":["best-bars-hongdae","cafes-gangnam"],"tags":["Street Food","Budget","Must Try"],"authorSlug":"mina-park","updatedDate":"2026-02-28","contentType":"guide"}}],["$","$L10","cafes-gangnam",{"guide":{"slug":"cafes-gangnam","title":"Best Cafes In Gangnam","city":"seoul","category":"food","neighbourhood":"Gangnam","neighbourhoodSlug":"gangnam","priceRange":"₩₩","nearestMetro":"Gangnam (Line 2)","openingHours":"9 AM – 10 PM","image":"https://images.unsplash.com/photo-1559305616-3f99cd43e353?w=1200&q=80","summary":"Design-forward coffee shops and hidden gems south of the river.","intro":"Gangnam's cafe scene is all about aesthetics and quality. Multi-storey minimalist spaces, rooftop gardens, and some of Seoul's best specialty coffee — these are the ones worth crossing the river for.","venues":[{"name":"Fritz Coffee","image":"https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=600&q=80","description":"A beloved Seoul roastery with a cosy industrial interior and pastries baked fresh on-site. Their hand-drip coffee is consistently excellent.","address":"17 Dosan-daero 15-gil, Gangnam-gu","tip":"Try the einspänner — their version with house-made whipped cream is the best in Seoul.","priceLevel":"₩₩"}],"relatedSlugs":["best-street-food-myeongdong"],"tags":["Coffee","Design","Brunch"],"authorSlug":"mina-park","updatedDate":"2026-03-05","contentType":"guide"}}],["$","$L10","hiking-bukhansan",{"guide":{"slug":"hiking-bukhansan","title":"Hiking Bukhansan National Park","city":"seoul","category":"things-to-do","neighbourhood":"Jongno","neighbourhoodSlug":"jamsil","priceRange":"Free","nearestMetro":"Gupabal (Line 3)","openingHours":"Sunrise – Sunset","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","summary":"Granite peaks and temple trails on the northern edge of Seoul.","intro":"Bukhansan is the dramatic granite mountain visible from almost anywhere in northern Seoul. Multiple trails wind through forests and past Buddhist temples to summit ridges with panoramic city views. It's one of the most visited national parks in the world — for good reason.","venues":[{"name":"Baegundae Peak Trail","image":"https://images.unsplash.com/photo-1551632811-561732d1e306?w=600&q=80","description":"The most popular trail to Bukhansan's highest point (836m). The final section involves steel cables and rock scrambling — exhilarating but not for the faint-hearted.","address":"Bukhansan National Park, Gangbuk-gu","tip":"Start before 7 AM on weekends to beat the crowds. Bring gloves for the cable section.","priceLevel":"Free"}],"relatedSlugs":["best-street-food-myeongdong"],"tags":["Hiking","Nature","Free"],"authorSlug":"mina-park","updatedDate":"2026-02-20","contentType":"guide"}}],["$","$L10","haeundae-beach-guide",{"guide":{"slug":"haeundae-beach-guide","title":"Haeundae Beach Guide","city":"busan","category":"things-to-do","neighbourhood":"Haeundae","neighbourhoodSlug":"haeundae","priceRange":"₩ – ₩₩","nearestMetro":"Haeundae (Line 2)","openingHours":"All day","image":"https://images.unsplash.com/photo-1573057284059-827a26b093f4?w=1200&q=80","summary":"Everything you need to know about Busan's most famous beach.","intro":"Haeundae is the beach you've seen in every Korean drama. A wide crescent of sand backed by high-rises, it's the epicentre of Busan's summer scene. But there's more to it than sunbathing — the surrounding area is packed with seafood restaurants, markets, and cliff walks.","venues":[{"name":"Haeundae Traditional Market","image":"https://images.unsplash.com/photo-1567521464027-f127ff144326?w=600&q=80","description":"A bustling covered market a few blocks from the beach. Fresh seafood, dried fish, street snacks and local produce at great prices.","address":"Gunam-ro 41beon-gil, Haeundae-gu","tip":"Head to the second floor for some of the best (and cheapest) raw fish sets in Busan.","priceLevel":"₩"}],"relatedSlugs":[],"tags":["Beach","Seafood","Summer"],"authorSlug":"mina-park","updatedDate":"2026-03-12","contentType":"guide"}}],["$","$L10","jeju-waterfalls",{"guide":{"slug":"jeju-waterfalls","title":"Jeju's Best Waterfalls","city":"jeju","category":"things-to-do","neighbourhood":"Seogwipo","neighbourhoodSlug":"seogwipo","priceRange":"₩","nearestMetro":"N/A — drive or bus","openingHours":"9 AM – 6 PM","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","summary":"Cheonjiyeon, Jeongbang and the hidden cascades of Jeju's south coast.","intro":"Jeju's volcanic geology has created some spectacular waterfalls, most of them clustered along the island's southern coast near Seogwipo. From the famous Jeongbang — one of the only waterfalls in Asia that falls directly into the ocean — to quieter cascades hidden in forest gorges, these are the ones to visit.","venues":[{"name":"Jeongbang Waterfall","image":"https://images.unsplash.com/photo-1433086966358-54859d0ed716?w=600&q=80","description":"A 23-metre waterfall that plunges directly into the sea. The viewing platform gets you close enough to feel the spray.","address":"Jeongbang-dong, Seogwipo-si","tip":"Visit after rain for the most dramatic flow. The coast path east of here is beautiful and usually empty.","priceLevel":"₩"}],"relatedSlugs":["haeundae-beach-guide"],"tags":["Nature","Hiking","Photography"],"authorSlug":"mina-park","updatedDate":"2026-03-01","contentType":"guide"}}]]}]]}],false,["$","section",null,{"className":"pb-14","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-bold text-foreground mb-6","children":["Travel Tips by ","Mina Park"]}],["$","div",null,{"className":"grid grid-cols-1 sm:grid-cols-2 gap-4","children":[["$","$L7","t-money-card-guide",{"href":"/travel-tips/t-money-card-guide","children":["$","div",null,{"className":"flex items-center gap-4 p-4 rounded-xl bg-card hover:bg-secondary/50 transition-colors h-full","style":{"boxShadow":"var(--shadow-card)"},"children":[["$","div",null,{"className":"w-14 h-14 rounded-lg overflow-hidden flex-shrink-0","children":["$","$Lf",null,{"src":"https://images.unsplash.com/photo-1517154421773-0529f29ea451?w=1200&q=80","alt":"","width":56,"height":56,"className":"w-full h-full object-cover"}]}],["$","div",null,{"className":"min-w-0","