is, how it's made and where to try it."}]]}]]}]}],["$","$L7","korean-won-etf-guide",{"href":"/travel-tips/korean-won-etf-guide","children":["$","div",null,{"className":"flex items-center gap-4 p-4 rounded-xl bg-card hover:bg-secondary/50 transition-colors h-full","style":{"boxShadow":"var(--shadow-card)"},"children":[["$","div",null,{"className":"w-14 h-14 rounded-lg overflow-hidden flex-shrink-0","children":["$","$Lf",null,{"src":"https://images.unsplash.com/photo-1621761191319-c6fb62004040?w=1200&q=80","alt":"","width":56,"height":56,"className":"w-full h-full object-cover"}]}],["$","div",null,{"className":"min-w-0","children":[["$","h3",null,{"className":"text-sm font-semibold text-foreground","children":"Korean Won Currency ETFs: A Traveller's Overview"}],["$","p",null,{"className":"text-xs text-muted-foreground mt-0.5 line-clamp-1","children":"What travellers should know about the Korean won, exchange rates and currency-focused ETFs."}]]}]]}]}]]}]]}],false]}]}]
