hbourhoods.","nearestMetro":"Anguk (Line 3)","vibe":"Traditional & photogenic","bestFor":["Hanok","Culture","Photography","Workshops"],"priceRange":"₩₩"}}]}],["$","div","namdaemun",{"className":"flex-shrink-0 w-64 sm:w-auto","children":["$","$L12",null,{"neighbourhood":{"slug":"namdaemun","name":"Namdaemun","citySlug":"seoul","image":"https://images.unsplash.com/photo-1498654896293-37aacf113fd9?w=1200&q=80","intro":"Home to Namdaemun Market, Korea's largest traditional market. Open 24/7 with clothing, souvenirs, street food and local produce. A no-frills, authentic Seoul experience.","nearestMetro":"Hoehyeon (Line 4)","vibe":"Busy & traditional","bestFor":["Markets","Street food","Souvenirs","Bargains"],"priceRange":"₩ – ₩₩"}}]}],["$","div","sinchon",{"className":"flex-shrink-0 w-64 sm:w-auto","children":["$","$L12",null,{"neighbourhood":{"slug":"sinchon","name":"Sinchon","citySlug":"seoul","image":"https://images.unsplash.com/photo-1514933651103-005eec06c04b?w=1200&q=80","intro":"University district near Yonsei and Ewha. Young crowd, affordable eats, karaoke and shopping. Lively day and night with a student-friendly vibe.","nearestMetro":"Sinchon (Line 2)","vibe":"Young & energetic","bestFor":["Food","Shopping","Karaoke","Nightlife"],"priceRange":"₩ – ₩₩"}}]}],["$","div","gangnam-station-area",{"className":"flex-shrink-0 w-64 sm:w-auto","children":["$","$L12",null,{"neighbourhood":{"slug":"gangnam-station-area","name":"Gangnam Station Area","citySlug":"seoul","image":"https://images.unsplash.com/photo-1559305616-3f99cd43e353?w=1200&q=80","intro":"The hub around Gangnam Station. Dense mix of offices, shops, cafes and nightlife. Underground shopping, exit-linked malls and 24-hour energy.","nearestMetro":"Gangnam (Line 2)","vibe":"Busy & commercial","bestFor":["Shopping","Nightlife","Cafes","Convenience"],"priceRange":"₩₩ – ₩₩₩₩"}}]}],["$","div","coex",{"className":"flex-shrink-0 w-64 sm:w-auto","children":["$","$L12",null,{"neighbourhood":{"slug":"coex","name":"COEX"