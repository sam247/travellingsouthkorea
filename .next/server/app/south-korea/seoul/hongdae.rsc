idential.","nearestMetro":"Noryangjin (Line 1/9)","vibe":"Markets & local","bestFor":["Seafood","Markets","Han River"],"priceRange":"₩ – ₩₩"}}]}],["$","div","eunpyeong",{"className":"flex-shrink-0 w-64 sm:w-auto","children":["$","$L12",null,{"neighbourhood":{"slug":"eunpyeong","name":"Eunpyeong","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Northwestern Seoul. Jingwansa Temple, Bukhansan foothills and a growing cafe scene in Gusan-dong. Calm and green.","nearestMetro":"Gusan (Gyeongui–Jungang Line)","vibe":"Temple & nature","bestFor":["Temples","Hiking","Cafes"],"priceRange":"₩ – ₩₩"}}]}],["$","div","jongno",{"className":"flex-shrink-0 w-64 sm:w-auto","children":["$","$L12",null,{"neighbourhood":{"slug":"jongno","name":"Jongno","citySlug":"seoul","image":"https://images.unsplash.com/photo-1517154421773-0529f29ea451?w=1200&q=80","intro":"Historic heart of Seoul. Gyeongbokgung, Changdeokgung, Jongmyo and Insadong. Palaces, museums and traditional culture.","nearestMetro":"Jongno 3-ga (Line 1/3/5)","vibe":"Historic & cultural","bestFor":["Palaces","Museums","Culture","Walking"],"priceRange":"₩ – ₩₩₩"}}]}],["$","div","jung",{"className":"flex-shrink-0 w-64 sm:w-auto","children":["$","$L12",null,{"neighbourhood":{"slug":"jung","name":"Jung","citySlug":"seoul","image":"https://images.unsplash.com/photo-1498654896293-37aacf113fd9?w=1200&q=80","intro":"Central district. Myeongdong, Namdaemun, City Hall and N Seoul Tower. The core of downtown shopping and landmarks.","nearestMetro":"Myeongdong (Line 4)","vibe":"Downtown & landmark","bestFor":["Shopping","Landmarks","Street food","Views"],"priceRange":"₩ – ₩₩₩"}}]}],["$","div","jungnang",{"className":"flex-shrink-0 w-64 sm:w-auto","children":["$","$L12",null,{"neighbourhood":{"slug":"jungnang","name":"Jungnang","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Eastern Seoul. Residential and green with Jungna