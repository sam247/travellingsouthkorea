,"div",null,{"className":"p-4 sm:p-5 flex-1","children":[["$","div",null,{"className":"flex items-start justify-between gap-2","children":[["$","h3",null,{"className":"text-base font-semibold text-foreground","children":"Challenger's League"}],["$","span",null,{"className":"text-xs font-medium text-muted-foreground whitespace-nowrap","children":"₩"}]]}],["$","p",null,{"className":"text-sm text-muted-foreground mt-1.5 leading-relaxed","children":"Chain PC bang with locations across Seoul. Clean, well-maintained and affordable."}],["$","p",null,{"className":"text-xs text-muted-foreground mt-2","children":"Multiple locations"}],["$","div",null,{"className":"mt-3 px-3 py-2.5 rounded-lg bg-primary/5 border border-primary/10","children":[["$","p",null,{"className":"text-xs font-medium text-primary mb-0.5","children":"Insider Tip"}],["$","p",null,{"className":"text-xs text-foreground leading-relaxed font-editorial","children":"Late night and early morning rates are often cheaper."}]]}]]}]]}]}]]}]]}],["$","section",null,{"className":"max-w-4xl mx-auto px-4 sm:px-6 pb-14","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-bold text-foreground mb-6","children":"Related Guides"}],["$","div",null,{"className":"grid grid-cols-1 sm:grid-cols-2 gap-5","children":[["$","$L11","best-bars-hongdae",{"guide":{"slug":"best-bars-hongdae","title":"Best Bars In Hongdae","city":"seoul","category":"nightlife","neighbourhood":"Hongdae","neighbourhoodSlug":"hongdae","priceRange":"₩₩ – ₩₩₩","nearestMetro":"Hongik University (Line 2)","openingHours":"6 PM – 3 AM","image":"https://images.unsplash.com/photo-1514933651103-005eec06c04b?w=1200&q=80","summary":"From craft cocktails to soju dives — the definitive Hongdae bar guide.","intro":"Hongdae's bar scene is as eclectic as the neighbourhood itself. Graffiti-walled dives sit next to sleek cocktail lounges, and on any given night the energy spills from the venues onto the streets. Here are the spots worth your time.","venues":[{"name":"Café Abyss","image":"https://images.unsplash.com/photo-1572116469696-31de0f17cc34?w=600&q=80","description":"A moody, candlelit cocktail bar with an extensive whisky list and jazz playing low in the background. The bartenders here are serious about their craft.","address":"32-8 Wausan-ro 21-gil, Mapo-gu","tip":"Ask for the off-menu 'Midnight Seoul' cocktail — it's their signature and it's incredible.","priceLevel":"₩₩₩"},{"name":"Thursday Party","image":"https://images.unsplash.com/photo-1566417713940-fe7c737a9ef2?w=600&q=80","description":"The quintessential Hongdae dive bar. Cheap soju towers, loud music, and a crowd that's always up for a good time. Don't come here for quiet conversation.","address":"19-3 Wausan-ro 29na-gil, Mapo-gu","tip":"Thursday nights are obviously the busiest — go Wednesday for the same vibe with more space.","priceLevel":"₩"},{"name":"Vault 82","image":"https://images.unsplash.com/photo-1525268323446-0505b6fe7778?w=600&q=80","description":"A speakeasy-style bar hidden behind an unmarked door. The cocktail menu changes seasonally and the interior feels like stepping into a 1920s bank vault.","address":"82 Eoulmadang-ro, Mapo-gu","tip":"Ring the doorbell and wait — the entrance is intentionally hard to find. Look for the brass plate.","priceLevel":"₩₩₩"}],"relatedSlugs":["nightlife-itaewon","best-street-food-myeongdong"],"tags":["Bars","Cocktails","Nightlife"],"authorSlug":"james-jeong","updatedDate":"2026-03-10","contentType":"guide"}}],["$","$L11","cafes-gangnam",{"guide":{"slug":"cafes-gangnam","title":"Best Cafes In Gangnam","city":"seoul","category":"food","neighbourhood":"Gangnam","neighbourhoodSlug":"gangnam","priceRange":"₩₩","nearestMetro":"Gangnam (Line 2)","openingHours":"9 AM – 10 PM","image":"https://images.unsplash.com/photo-1559305616-3f99cd43e353?w=1200&q=80","summary":"Design-forward coffee shops and hidden gems south of the river.","intro":"Gangnam's cafe scene is all about aesthetics and quality. Multi-storey minimalist spaces, rooftop gardens, and some of Seoul's best specialty coffee — these are the ones worth crossing the river for.","venues":[{"name":"Fritz Coffee","image":"https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=600&q=80","description":"A beloved Seoul roastery with a cosy industrial interior and pastries baked fresh on-site. Their hand-drip coffee is consistently excellent.","address":"17 Dosan-daero 15-gil, Gangnam-gu","tip":"Try the einspänner — their version with house-made whipped cream is the best in Seoul.","priceLevel":"₩₩"}],"relatedSlugs":["best-street-food-myeongdong"],"tags":["Coffee","Design","Brunch"],"authorSlug":"mina-park","updatedDate":"2026-03-05","contentType":"guide"}}]]}]]}],["$","section",null,{"className":"max-w-4xl mx-auto px-4 sm:px-6 pb-14","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-bold text-foreground mb-6","children":["More in ",""]}],["$","div",null,{"className":"grid grid-cols-1 sm:grid-cols-2 gap-5","children":[["$","$L11","best-bars-hongdae",{"guide":"$12"}],["$","$L11","nightlife-itaewon",{"guide":{"slug":"nightlife-itaewon","title":"Itaewon After Dark","city":"seoul","category":"nightlife","neighbourhood":"Itaewon","neighbourhoodSlug":"itaewon","priceRange":"₩₩ – ₩₩₩₩","nearestMetro":"Itaewon (Line 6)","openingHours":"8 PM – 5 AM","image":"https://images.unsplash.com/photo-1519608487953-e999c86e7455?w=1200&q=80","summary":"Seoul's most international nightlife district — rooftop bars, clubs and late-night eats.","intro":"Itaewon has always been Seoul's most cosmopolitan neighbourhood, and its nightlife reflects that. From rooftop cocktail bars overlooking the city to underground clubs playing everything from techno to K-pop, this is where Seoul stays up latest.","venues":[{"name":"Southside Parlor","image":"https://images.unsplash.com/photo-1470337458703-46ad1756a187?w=600&q=80","description":"A Southern-inspired whisky bar that feels like it was teleported from Nashville. Great bourbon selection and surprisingly good fried chicken.","address":"218 Noksapyeong-daero, Yongsan-gu","tip":"The upstairs terrace opens in spring and summer — get there early to grab a seat.","priceLevel":"₩₩₩"}],"relatedSlugs":["best-bars-hongdae"],"tags":["Clubs","Rooftop Bars","Late Night"],"authorSlug":"james-jeong","updatedDate":"2026-03-08","contentType":"guide"}}],["$","$L11","best-street-food-myeongdong",{"guide":{"slug":"best-street-food-myeongdong","title":"Best Street Food In Myeongdong","city":"seoul","category":"food","neighbourhood":"Myeongdong","neighbourhoodSlug":"myeongdong","priceRange":"₩","nearestMetro":"Myeongdong (Line 4)","openingHours":"11 AM – 10 PM","image":"https://images.unsplash.com/photo-1498654896293-37aacf113fd9?w=1200&q=80","summary":"Tteokbokki, hotteok, tornado potatoes — everything you need to eat on Myeongdong's food streets.","intro":"Myeongdong's main streets transform into an open-air food market every afternoon. Vendors line both sides selling everything from freshly grilled skewers to towering soft-serve ice cream. Come hungry.","venues":[{"name":"Myeongdong Kyoja","image":"https://images.unsplash.com/photo-1590301157890-4810ed352733?w=600&q=80","description":"A Myeongdong institution serving handmade kalguksu (knife-cut noodles) since 1966. The broth is rich and deeply savoury.","address":"29 Myeongdong 10-gil, Jung-gu","tip":"There's always a queue but it moves fast. The mandu (dumplings) are a must-order alongside the noodles.","priceLevel":"₩"}],"relatedSlugs":["best-bars-hongdae","cafes-gangnam"],"tags":["Street Food","Budget","Must Try"],"authorSlug":"mina-park","updatedDate":"2026-02-28","contentType":"guide"}}],["$","$L11","cafes-gangnam",{"guide":"$19"}]]}]]}]]}]
