2:["$","div",null,{"className":"min-h-screen bg-background","children":[["$","section",null,{"className":"pt-24 sm:pt-28 pb-6 sm:pb-8 max-w-7xl mx-auto px-4 sm:px-6","children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://travellingsouthkorea.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"South Korea\",\"item\":\"https://travellingsouthkorea.com/south-korea\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Seoul\",\"item\":\"https://travellingsouthkorea.com/south-korea/seoul\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Nightlife\"}]}"}}],["$","$La",null,{"children":["$","$Lb",null,{"children":[["$","$Lc","0",{"children":[false,["$","$Ld",null,{"asChild":true,"children":["$","$L8",null,{"href":"/","children":"Home"}]}]]}],["$","$Lc","1",{"children":[["$","$Le",null,{}],["$","$Ld",null,{"asChild":true,"children":["$","$L8",null,{"href":"/south-korea","children":"South Korea"}]}]]}],["$","$Lc","2",{"children":[["$","$Le",null,{}],["$","$Ld",null,{"asChild":true,"children":["$","$L8",null,{"href":"/south-korea/seoul","children":"Seoul"}]}]]}],["$","$Lc","3",{"children":[["$","$Le",null,{}],["$","$Lf",null,{"children":"Nightlife"}]]}]]}]}]],["$","h1",null,{"className":"text-3xl sm:text-4xl font-bold text-foreground mt-4","children":["Nightlife"," in ","Seoul"]}],["$","p",null,{"className":"text-muted-foreground mt-2","children":"Bars, clubs, rooftops and everything after dark"}]]}],["$","section",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 pb-10 sm:pb-14","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-bold text-foreground mb-6","children":"Guides"}],["$","div",null,{"className":"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5","children":[["$","$L10","best-bars-hongdae",{"guide":{"slug":"best-bars-hongdae","title":"Best Bars In Hongdae","city":"seoul","category":"nightlife","neighbourhood":"Hongdae","neighbourhoodSlug":"hongdae","priceRange":"₩₩ – ₩₩₩","nearestMetro":"Hongik University (Line 2)","openingHours":"6 PM – 3 AM","image":"https://images.unsplash.com/photo-1514933651103-005eec06c04b?w=1200&q=80","summary":"From craft cocktails to soju dives — the definitive Hongdae bar guide.","intro":"Hongdae's bar scene is as eclectic as the neighbourhood itself. Graffiti-walled dives sit next to sleek cocktail lounges, and on any given night the energy spills from the venues onto the streets. Here are the spots worth your time.","venues":[{"name":"Café Abyss","image":"https://images.unsplash.com/photo-1572116469696-31de0f17cc34?w=600&q=80","description":"A moody, candlelit cocktail bar with an extensive whisky list and jazz playing low in the background. The bartenders here are serious about their craft.","address":"32-8 Wausan-ro 21-gil, Mapo-gu","tip":"Ask for the off-menu 'Midnight Seoul' cocktail — it's their signature and it's incredible.","priceLevel":"₩₩₩"},{"name":"Thursday Party","image":"https://images.unsplash.com/photo-1566417713940-fe7c737a9ef2?w=600&q=80","description":"The quintessential Hongdae dive bar. Cheap soju towers, loud music, and a crowd that's always up for a good time. Don't come here for quiet conversation.","address":"19-3 Wausan-ro 29na-gil, Mapo-gu","tip":"Thursday nights are obviously the busiest — go Wednesday for the same vibe with more space.","priceLevel":"₩"},{"name":"Vault 82","image":"https://images.unsplash.com/photo-1525268323446-0505b6fe7778?w=600&q=80","description":"A speakeasy-style bar hidden behind an unmarked door. The cocktail menu changes seasonally and the interior feels like stepping into a 1920s bank vault.","address":"82 Eoulmadang-ro, Mapo-gu","tip":"Ring the doorbell and wait — the entrance is intentionally hard to find. Look for the brass plate.","priceLevel":"₩₩₩"}],"relatedSlugs":["nightlife-itaewon","best-street-food-myeongdong"],"tags":["Bars","Cocktails","Nightlife"],"authorSlug":"james-jeong","updatedDate":"2026-03-10","contentType":"guide"}}],["$","$L10","nightlife-itaewon",{"guide":{"slug":"nightlife-itaewon","title":"Itaewon After Dark","city":"seoul","category":"nightlife","neighbourhood":"Itaewon","neighbourhoodSlug":"itaewon","priceRange":"₩₩ – ₩₩₩₩","nearestMetro":"Itaewon (Line 6)","openingHours":"8 PM – 5 AM","image":"https://images.unsplash.com/photo-1519608487953-e999c86e7455?w=1200&q=80","summary":"Seoul's most international nightlife district — rooftop bars, clubs and late-night eats.","intro":"Itaewon has always been Seoul's most cosmopolitan neighbourhood, and its nightlife reflects that. From rooftop cocktail bars overlooking the city to underground clubs playing everything from techno to K-pop, this is where Seoul stays up latest.","venues":[{"name":"Southside Parlor","image":"https://images.unsplash.com/photo-1470337458703-46ad1756a187?w=600&q=80","description":"A Southern-inspired whisky bar that feels like it was teleported from Nashville. Great bourbon selection and surprisingly good fried chicken.","address":"218 Noksapyeong-daero, Yongsan-gu","tip":"The upstairs terrace opens in spring and summer — get there early to grab a seat.","priceLevel":"₩₩₩"}],"relatedSlugs":["best-bars-hongdae"],"tags":["Clubs","Rooftop Bars","Late Night"],"authorSlug":"james-jeong","updatedDate":"2026-03-08","contentType":"guide"}}]]}]]}],["$","section",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 pb-14","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-bold text-foreground mb-6","children":"Venues"}],["$","div",null,{"className":"flex flex-col gap-3","children":[["$","$L8",null,{"href":"/south-korea/seoul/venues/cafe-abyss","className":"group flex gap-3 sm:gap-4 p-3 rounded-xl bg-card transition-all duration-200 hover:bg-secondary/50","style":{"boxShadow":"var(--shadow-card)"},"children":[["$","div",null,{"className":"w-20 h-20 sm:w-24 sm:h-24 rounded-lg overfl