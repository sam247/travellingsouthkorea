cale-105","sizes":"(max-width: 768px) 50vw, 33vw"}],["$","div",null,{"className":"absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"}],["$","div",null,{"className":"absolute bottom-0 left-0 right-0 p-3 sm:p-4","children":["$","p",null,{"className":"text-sm sm:text-base font-semibold text-white","children":"Travel Tips"}]}]]}]]}]]}],["$","section",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 pb-14","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-bold text-foreground mb-6","children":"Neighbourhoods"}],["$","div",null,{"className":"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5","children":[["$","$L10","itaewon",{"neighbourhood":"$11"}],["$","$L10","hongdae",{"neighbourhood":"$13"}],["$","$L10","gangnam",{"neighbourhood":"$15"}],["$","$L10","myeongdong",{"neighbourhood":"$17"}],["$","$L10","insadong",{"neighbourhood":"$19"}],["$","$L10","apgujeong",{"neighbourhood":"$1b"}],["$","$L10","jamsil",{"neighbourhood":{"slug":"jamsil","name":"Jamsil","citySlug":"seoul","image":"https://images.unsplash.com/photo-1617469767053-d3b523a0b982?w=1200&q=80","intro":"Home to Lotte World, the Olympic Park and Seoul's modern entertainment district. Jamsil combines family-friendly attractions with excellent shopping at Lotte World Mall and surprisingly good local food spots.","nearestMetro":"Jamsil (Line 2/8)","vibe":"Entertainment & family","bestFor":["Theme parks","Shopping","Sports","Lake walks"],"priceRange":"₩₩ – ₩₩₩"}}],["$","$L10","garosu-gil",{"neighbourhood":{"slug":"garosu-gil","name":"Garosu-gil","citySlug":"seoul","image":"https://images.unsplash.com/photo-1559305616-3f99cd43e353?w=1200&q=80","intro":"Tree-lined street in Sinsa-dong famous for indie boutiques, design shops and cafes. A quieter, more refined alternative to Gangnam Station with a strong fashion and brunch scene.","nearestMetro":"Sinsa (Line 3)","vibe":"Trendy & leafy","bestFor":["Cafes","Fashion","Brunch","Design"],"priceRange":"₩₩₩"}}],["$","$L10","seongsu",{"neighbourhood":{"slug":"seongsu","name":"Seongsu","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"The 'Brooklyn of Seoul'. Former shoe factories turned into cafes, galleries and concept stores. Seongsu has become the go-to area for creative types and specialty coffee.","nearestMetro":"Seongsu (Line 2)","vibe":"Industrial & creative","bestFor":["Cafes","Art","Shopping","Photo spots"],"priceRange":"₩₩ – ₩₩₩"}}],["$","$L10","yeonnam",{"neighbourhood":{"slug":"yeonnam","name":"Yeonnam","citySlug":"seoul","image":"https://images.unsplash.com/photo-1514933651103-005eec06c04b?w=1200&q=80","intro":"Just west of Hongdae, Yeonnam-dong offers a slightly calmer vibe with hip cafes, small galleries and the popular Yeontral Park. A favourite for brunch and casual hangs.","nearestMetro":"Hongik University (Line 2)","vibe":"Relaxed & hip","bestFor":["Cafes","Brunch","Parks","Walking"],"priceRange":"₩₩ – ₩₩₩"}}],["$","$L10","hannam",{"neighbourhood":{"slug":"hannam","name":"Hannam","citySlug":"seoul","image":"https://images.unsplash.com/photo-1519608487953-e999c86e7455?w=1200&q=80","intro":"Upscale residential area between Itaewon and Hannam-dong. Low-key luxury, international schools and some of Seoul's best low-profile restaurants and wine bars.","nearestMetro":"Hannam (Gyeongui–Jungang Line)","vibe":"Understated & upscale","bestFor":["Fine dining","Wine bars","Quiet cafes"],"priceRange":"₩₩₩ – ₩₩₩₩"}}],["$","$L10","samcheong",{"neighbourhood":{"slug":"samcheong","name":"Samcheong","citySlug":"seoul","image":"https://images.unsplash.com/photo-1517154421773-0529f29ea451?w=1200&q=80","intro":"Hanok-lined streets between Gyeongbokgung and Bukchon. Traditional tea houses, small museums and galleries with views of the palace and mountains.","nearestMetro":"Anguk (Line 3)","vibe":"Traditional & quiet","bestFor":["Culture","Tea","Palace views","Walking"],"priceRange":"₩₩ – ₩₩₩"}}],["$","$L10","bukchon",{"neighbourhood":{"slug":"bukchon","name":"Bukchon","citySlug":"seoul","image":"https://images.unsplash.com/photo-1517154421773-0529f29ea451?w=1200&q=80","intro":"Bukchon Hanok Village preserves hundreds of traditional houses. Wander the alleys, try on hanbok or join a craft workshop. One of Seoul's most photogenic neighbourhoods.","nearestMetro":"Anguk (Line 3)","vibe":"Traditional & photogenic","bestFor":["Hanok","Culture","Photography","Workshops"],"priceRange":"₩₩"}}],["$","$L10","namdaemun",{"neighbourhood":{"slug":"namdaemun","name":"Namdaemun","citySlug":"seoul","image":"https://images.unsplash.com/photo-1498654896293-37aacf113fd9?w=1200&q=80","intro":"Home to Namdaemun Market, Korea's largest traditional market. Open 24/7 with clothing, souvenirs, street food and local produce. A no-frills, authentic Seoul experience.","nearestMetro":"Hoehyeon (Line 4)","vibe":"Busy & traditional","bestFor":["Markets","Street food","Souvenirs","Bargains"],"priceRange":"₩ – ₩₩"}}],["$","$L10","sinchon",{"neighbourhood":{"slug":"sinchon","name":"Sinchon","citySlug":"seoul","image":"https://images.unsplash.com/photo-1514933651103-005eec06c04b?w=1200&q=80","intro":"University district near Yonsei and Ewha. Young crowd, affordable eats, karaoke and shopping. Lively day and night with a student-friendly vibe.","nearestMetro":"Sinchon (Line 2)","vibe":"Young & energetic","bestFor":["Food","Shopping","Karaoke","Nightlife"],"priceRange":"₩ – ₩₩"}}],["$","$L10","gangnam-station-area",{"neighbourhood":{"slug":"gangnam-station-area","name":"Gangnam Station Area","citySlug":"seoul","image":"https://images.unsplash.com/photo-1559305616-3f99cd43e353?w=1200&q=80","intro":"The hub around Gangnam Station. Dense mix of offices, shops, cafes and nightlife. Underground shopping, exit-linked malls and 24-hour energy.","nearestMetro":"Gangnam (Line 2)","vibe":"Busy & commercial","bestFor":["Shopping","Nightlife","Cafes","Convenience"],"priceRange":"₩₩ – ₩₩₩₩"}}],["$","$L10","coex",{"neighbourhood":{"slug":"coex","name":"COEX","citySlug":"seoul","image":"https://images.unsplash.com/photo-1617469767053-d3b523a0b982?w=1200&q=80","intro":"COEX Mall and Starfield: one of Asia's largest underground malls. Aquarium, library, cinema and events. Part of the Samseong business and convention district.","nearestMetro":"Samseong (Line 2)","vibe":"Modern & mega-scale","bestFor":["Shopping","Aquarium","Events","Convenience"],"priceRange":"₩₩ – ₩₩₩"}}],["$","$L10","apgujeong-rodeo",{"neighbourhood":{"slug":"apgujeong-rodeo","name":"Apgujeong Rodeo","citySlug":"seoul","image":"https://images.unsplash.com/photo-1559305616-3f99cd43e353?w=1200&q=80","intro":"The high-fashion strip of Apgujeong. Designer flagships, celebrity spotting and the original Rodeo Street. Glamorous and people-watching central.","nearestMetro":"Apgujeong Rodeo (Bundang Line)","vibe":"Luxury & glamour","bestFor":["Fashion","Luxury shopping","People watching"],"priceRange":"₩₩₩₩"}}],["$","$L10","gangdong",{"neighbourhood":{"slug":"gangdong","name":"Gangdong","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Eastern Seoul across the Han. Residential, green and home to Olympic Park extension, Amsa-dong prehistoric site and riverside parks.","nearestMetro":"Gangdong (Line 5)","vibe":"Green & residential","bestFor":["Parks","History","Riverside"],"priceRange":"₩₩"}}],["$","$L10","gangbuk",{"neighbourhood":{"slug":"gangbuk","name":"Gangbuk","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"North of the Han River. Mix of older residential neighbourhoods, universities and historic sites. More laid-back than the south.","nearestMetro":"Dobong (Line 1/7)","vibe":"Residential & calm","bestFor":["Local life","Parks","History"],"priceRange":"₩ – ₩₩"}}],["$","$L10","gangseo",{"neighbourhood":{"slug":"gangseo","name":"Gangseo","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Western Seoul. Gimpo Airport access, Magok, and a growing business and tech corridor. Mix of industry and new development.","nearestMetro":"Magok (Line 5)","vibe":"Sprawling & practical","bestFor":["Transport","Business","Parks"],"priceRange":"₩₩"}}],["$","$L10","gwanak",{"neighbourhood":{"slug":"gwanak","name":"Gwanak","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Home to Seoul National University. Student area with affordable food and nightlife, plus Gwanak Mountain hiking and parks.","nearestMetro":"Seoul National University (Line 2)","vibe":"Academic & affordable","bestFor":["Hiking","Food","Student vibe"],"priceRange":"₩ – ₩₩"}}],["$","$L10","gwangjin",{"neighbourhood":{"slug":"gwangjin","name":"Gwangjin","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Eastern district with Konkuk University area, Children's Grand Park and the growing Seongsu cafe and creative scene.","nearestMetro":"Konkuk University (Line 2/7)","vibe":"Young & creative","bestFor":["Cafes","Parks","Nightlife"],"priceRange":"₩ – ₩₩₩"}}],["$","$L10","guro",{"neighbourhood":{"slug":"guro","name":"Guro","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Southwestern district. Guro Digital Complex, tech offices and affordable dining. Practical and less touristy.","nearestMetro":"Guro Digital Complex (Line 2)","vibe":"Industrial & practical","bestFor":["Tech","Affordable food","Shopping"],"priceRange":"₩ – ₩₩"}}],["$","$L10","geumcheon",{"neighbourhood":{"slug":"geumcheon","name":"Geumcheon","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Southern district with a mix of residential and light industry. Affordable and well connected by Line 1 and 7.","nearestMetro":"Geumcheon-gu Office (Line 1)","vibe":"Residential & local","bestFor":["Local life","Affordable eats"],"priceRange":"₩"}}],["$","$L10","dobong",{"neighbourhood":{"slug":"dobong","name":"Dobong","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Northern Seoul. Dobong Mountain and Bukhansan access. Hiking, temples and a quieter residential feel.","nearestMetro":"Dobong (Line 1/7)","vibe":"Nature & residential","bestFor":["Hiking","Temples","Nature"],"priceRange":"₩ – ₩₩"}}],["$","$L10","dongdaemun",{"neighbourhood":{"slug":"dongdaemun","name":"Dongdaemun","citySlug":"seoul","image":"https://images.unsplash.com/photo-1498654896293-37aacf113fd9?w=1200&q=80","intro":"Dongdaemun Design Plaza and the famous 24-hour wholesale and retail markets. Fashion, fabrics and street food in a landmark district.","nearestMetro":"Dongdaemun (Line 1/4)","vibe":"24/7 & commercial","bestFor":["Shopping","Markets","Architecture","Street food"],"priceRange":"₩ – ₩₩₩"}}],["$","$L10","dongjak",{"neighbourhood":{"slug":"dongjak","name":"Dongjak","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"South of the river. Noryangjin Fish Market, Sadang area and access to the Han. Mix of markets and residential.","nearestMetro":"Noryangjin (Line 1/9)","vibe":"Markets & local","bestFor":["Seafood","Markets","Han River"],"priceRange":"₩ – ₩₩"}}],["$","$L10","eunpyeong",{"neighbourhood":{"slug":"eunpyeong","name":"Eunpyeong","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Northwestern Seoul. Jingwansa Temple, Bukhansan foothills and a growing cafe scene in Gusan-dong. Calm and green.","nearestMetro":"Gusan (Gyeongui–Jungang Line)","vibe":"Temple & nature","bestFor":["Temples","Hiking","Cafes"],"priceRange":"₩ – ₩₩"}}],["$","$L10","jongno",{"neighbourhood":{"slug":"jongno","name":"Jongno","citySlug":"seoul","image":"https://images.unsplash.com/photo-1517154421773-0529f29ea451?w=1200&q=80","intro":"Historic heart of Seoul. Gyeongbokgung, Changdeokgung, Jongmyo and Insadong. Palaces, museums and traditional culture.","nearestMetro":"Jongno 3-ga (Line 1/3/5)","vibe":"Historic & cultural","bestFor":["Palaces","Museums","Culture","Walking"],"priceRange":"₩ – ₩₩₩"}}],["$","$L10","jung",{"neighbourhood":{"slug":"jung","name":"Jung","citySlug":"seoul","image":"https://images.unsplash.com/photo-1498654896293-37aacf113fd9?w=1200&q=80","intro":"Central district. Myeongdong, Namdaemun, City Hall and N Seoul Tower. The core of downtown shopping and landmarks.","nearestMetro":"Myeongdong (Line 4)","vibe":"Downtown & landmark","bestFor":["Shopping","Landmarks","Street food","Views"],"priceRange":"₩ – ₩₩₩"}}],["$","$L10","jungnang",{"neighbourhood":{"slug":"jungnang","name":"Jungnang","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Eastern Seoul. Residential and green with Jungnang Stream and parks. Quiet and family-oriented.","nearestMetro":"Jungnang (Gyeongui–Jungang Line)","vibe":"Residential & green","bestFor":["Parks","Local life"],"priceRange":"₩ – ₩₩"}}],["$","$L10","mapo",{"neighbourhood":{"slug":"mapo","name":"Mapo","citySlug":"seoul","image":"https://images.unsplash.com/photo-1514933651103-005eec06c04b?w=1200&q=80","intro":"Home to Hongdae, Yeonnam and the Han River parks. Youth culture, indie music and some of Seoul's best nightlife and cafes.","nearestMetro":"Hongik University (Line 2)","vibe":"Youth & culture","bestFor":["Nightlife","Cafes","Parks","Music"],"priceRange":"₩ – ₩₩₩"}}],["$","$L10","nowon",{"neighbourhood":{"slug":"nowon","name":"Nowon","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Northeastern Seoul. Dense residential area with good transport, local markets and access to Suraksan and Dobongsan.","nearestMetro":"Nowon (Line 4/7)","vibe":"Residential & practical","bestFor":["Local life","Hiking","Markets"],"priceRange":"₩ – ₩₩"}}],["$","$L10","seocho",{"neighbourhood":{"slug":"seocho","name":"Seocho","citySlug":"seoul","image":"https://images.unsplash.com/photo-1559305616-3f99cd43e353?w=1200&q=80","intro":"South of the river. Gangnam Station, Seocho office district and a mix of business, shopping and dining. Central to the Gangnam area.","nearestMetro":"Seocho (Line 2)","vibe":"Business & upscale","bestFor":["Business","Shopping","Dining"],"priceRange":"₩₩ – ₩₩₩₩"}}],["$","$L10","seodaemun",{"neighbourhood":{"slug":"seodaemun","name":"Seodaemun","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Northwestern Seoul. Independence Park, Seodaemun Prison History Hall and Ewha Womans University area. History and student life.","nearestMetro":"Dongnimmun (Line 3)","vibe":"History & campus","bestFor":["History","Universities","Parks"],"priceRange":"₩ – ₩₩"}}],["$","$L10","seongdong",{"neighbourhood":{"slug":"seongdong","name":"Seongdong","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Eastern district. Seongsu's cafes and creative scene, plus Wangsimni transport hub. A blend of industry and trendiness.","nearestMetro":"Seongsu (Line 2)","vibe":"Creative & mixed","bestFor":["Cafes","Seongsu","Transport"],"priceRange":"₩ – ₩₩₩"}}],["$","$L10","seongbuk",{"neighbourhood":{"slug":"seongbuk","name":"Seongbuk","citySlug":"seoul","image":"https://images.unsplash.com/photo-1517154421773-0529f29ea451?w=1200&q=80","intro":"Northern Seoul. Bukhan Mountain foothills, traditional villages and a quieter, older-Seoul feel. Good for temples and walks.","nearestMetro":"Hansung University (Line 4)","vibe":"Traditional & quiet","bestFor":["Temples","Walking","Local life"],"priceRange":"₩ – ₩₩"}}],["$","$L10","songpa",{"neighbourhood":{"slug":"songpa","name":"Songpa","citySlug":"seoul","image":"https://images.unsplash.com/photo-1617469767053-d3b523a0b982?w=1200&q=80","intro":"Southeastern Seoul. Jamsil, Lotte World, Olympic Park and the Han River. Family attractions, sports and modern development.","nearestMetro":"Jamsil (Line 2/8)","vibe":"Entertainment & family","bestFor":["Theme parks","Sports","Parks","Shopping"],"priceRange":"₩₩ – ₩₩₩"}}],["$","$L10","yangcheon",{"neighbourhood":{"slug":"yangcheon","name":"Yangcheon","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Southwestern Seoul. Mok-dong residential area and Yangcheon Park. Family-oriented and well connected.","nearestMetro":"Mok-dong (Line 5)","vibe":"Residential & family","bestFor":["Parks","Local life"],"priceRange":"₩ – ₩₩"}}],["$","$L10","yeongdeungpo",{"neighbourhood":{"slug":"yeongdeungpo","name":"Yeongdeungpo","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Major commercial hub on the south side. Yeouido, Times Square and financial district. Business, shopping and Han River access.","nearestMetro":"Yeongdeungpo (Line 1/2)","vibe":"Business & commercial","bestFor":["Business","Shopping","Yeouido","Han River"],"priceRange":"₩₩ – ₩₩₩"}}],["$","$L10","yongsan",{"neighbourhood":{"slug":"yongsan","name":"Yongsan","citySlug":"seoul","image":"https://images.unsplash.com/photo-1519608487953-e999c86e7455?w=1200&q=80","intro":"Central district spanning Itaewon, Hannam and Yongsan Station. International vibe, embassies, museums and the huge Yongsan Electronics Market.","nearestMetro":"Itaewon (Line 6)","vibe":"International & mixed","bestFor":["Nightlife","Itaewon","Electronics","Museums"],"priceRange":"₩ – ₩₩₩₩"}}]]}]]}],["$","section",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 pb-10","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-bold text-foreground mb-4","children":["Explore ","Seoul"]}],["$","div",null,{"className":"flex flex-wrap gap-2","children":[["$","$L7","bars",{"href":"/south-korea/seoul/category/bars","className":"px-4 py-2 rounded-full text-sm font-medium bg-secondary text-foreground hover:bg-primary hover:text-primary-foreground transition-colors","children":"Bars"}],["$","$L7","restaurants",{"href":"/south-korea/seoul/category/restaurants","className":"px-4 py-2 rounded-full text-sm font-medium bg-secondary text-foreground hover:bg-primary hover:text-primary-foreground transition-colors","children":"Restaurants"}],["$","$L7","cafes",{"href":"/south-korea/seoul/category/cafes","className":"px-4 py-2 rounded-full text-sm font-medium bg-secondary text-foreground hover:bg-primary hover:text-primary-foreground transition-colors","children":"Cafes"}],["$","$L7","things-to-do",{"href":"/south-korea/seoul/category/things-to-do","className":"px-4 py-2 rounded-full text-sm font-medium bg-secondary text-foreground hover:bg-primary hover:text-primary-foreground transition-colors","children":"Things to do"}],["$","$L7","itineraries",{"href":"/south-korea/seoul/category/itineraries","className":"px-4 py-2 rounded-full text-sm font-medium bg-secondary text-foreground hover:bg-primary hover:text-primary-foreground transition-colors","children":"Itineraries"}],["$","$L7","travel-tips",{"href":"/south-korea/seoul/category/travel-tips","className":"px-4 py-2 rounded-full text-sm font-medium bg-secondary text-foreground hover:bg-primary hover:text-primary-foreground transition-colors","children":"Travel tips"}],["$","$L7","neighbourhoods",{"href":"/south-korea/seoul/category/neighbourhoods","className":"px-4 py-2 rounded-full text-sm font-medium bg-secondary text-foreground hover:bg-primary hover:text-primary-foreground transition-colors","children":"Neighbourhoods"}]]}]]}],["$","section",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 pb-14","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-bold text-foreground mb-6","children":"Featured Guides"}],["$","div",null,{"className":"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5","children":[["$","$L1d","best-bars-hongdae",{"guide":{"slug":"best-bars-hongdae","title":"Best Bars In Hongdae","city":"seoul","category":"nightlife","neighbourhood":"Hongdae","neighbourhoodSlug":"hongdae","priceRange":"₩₩ – ₩₩₩","nearestMetro":"Hongik University (Line 2)","openingHours":"6 PM – 3 AM","image":"https://images.unsplash.com/photo-1514933651103-005eec06c04b?w=1200&q=80","summary":"From craft cocktails to soju dives — the definitive Hongdae bar guide.","intro":"Hongdae's bar scene is as eclectic as the neighbourhood itself. Graffiti-walled dives sit next to sleek cocktail lounges, and on any given night the energy spills from the venues onto the streets. Here are the spots worth your time.","venues":[{"name":"Café Abyss","image":"https://images.unsplash.com/photo-1572116469696-31de0f17cc34?w=600&q=80","description":"A moody, candlelit cocktail bar with an extensive whisky list and jazz playing low in the background. The bartenders here are serious about their craft.","address":"32-8 Wausan-ro 21-gil, Mapo-gu","tip":"Ask for the off-menu 'Midnight Seoul' cocktail — it's their signature and it's incredible.","priceLevel":"₩₩₩"},{"name":"Thursday Party","image":"https://images.unsplash.com/photo-1566417713940-fe7c737a9ef2?w=600&q=80","description":"The quintessential Hongdae dive bar. Cheap soju towers, loud music, and a crowd that's always up for a good time. Don't come here for quiet conversation.","address":"19-3 Wausan-ro 29na-gil, Mapo-gu","tip":"Thursday nights are obviously the busiest — go Wednesday for the same vibe with more space.","priceLevel":"₩"},{"name":"Vault 82","image":"https://images.unsplash.com/photo-1525268323446-0505b6fe7778?w=600&q=80","description":"A speakeasy-style bar hidden behind an unmarked door. The cocktail menu changes seasonally and the interior feels like stepping into a 1920s bank vault.","address":"82 Eoulmadang-ro, Mapo-gu","tip":"Ring the doorbell and wait — the entrance is intentionally hard to find. Look for the brass plate.","priceLevel":"₩₩₩"}],"relatedSlugs":["nightlife-itaewon","best-street-food-myeongdong"],"tags":["Bars","Cocktails","Nightlife"],"authorSlug":"james-jeong","updatedDate":"2026-03-10","contentType":"guide"}}],["$","$L1d","nightlife-itaewon",{"guide":{"slug":"nightlife-itaewon","title":"Itaewon After Dark","city":"seoul","category":"nightlife","neighbourhood":"Itaewon","neighbourhoodSlug":"itaewon","priceRange":"₩₩ – ₩₩₩₩","nearestMetro":"Itaewon (Line 6)","openingHours":"8 PM – 5 AM","image":"https://images.unsplash.com/photo-1519608487953-e999c86e7455?w=1200&q=80","summary":"Seoul's most international nightlife district — rooftop bars, clubs and late-night eats.","intro":"Itaewon has always been Seoul's most cosmopolitan neighbourhood, and its nightlife reflects that. From rooftop cocktail bars overlooking the city to underground clubs playing everything from techno to K-pop, this is where Seoul stays up latest.","venues":[{"name":"Southside Parlor","image":"https://images.unsplash.com/photo-1470337458703-46ad1756a187?w=600&q=80","description":"A Southern-inspired whisky bar that feels like it was teleported from Nashville. Great bourbon selection and surprisingly good fried chicken.","address":"218 Noksapyeong-daero, Yongsan-gu","tip":"The upstairs terrace opens in spring and summer — get there early to grab a seat.","priceLevel":"₩₩₩"}],"relatedSlugs":["best-bars-hongdae"],"tags":["Clubs","Rooftop Bars","Late Night"],"authorSlug":"james-jeong","updatedDate":"2026-03-08","contentType":"guide"}}],["$","$L1d","best-street-food-myeongdong",{"guide":{"slug":"best-street-food-myeongdong","title":"Best Street Food In Myeongdong","city":"seoul","category":"food","neighbourhood":"Myeongdong","neighbourhoodSlug":"myeongdong","priceRange":"₩","nearestMetro":"Myeongdong (Line 4)","openingHours":"11 AM – 10 PM","image":"https://images.unsplash.com/photo-1498654896293-37aacf113fd9?w=1200&q=80","summary":"Tteokbokki, hotteok, tornado potatoes — everything you need to eat on Myeongdong's food streets.","intro":"Myeongdong's main streets transform into an open-air food market every afternoon. Vendors line both sides selling everything from freshly grilled skewers to towering soft-serve ice cream. Come hungry.","venues":[{"name":"Myeongdong Kyoja","image":"https://images.unsplash.com/photo-1590301157890-4810ed352733?w=600&q=80","description":"A Myeongdong institution serving handmade kalguksu (knife-cut noodles) since 1966. The broth is rich and deeply savoury.","address":"29 Myeongdong 10-gil, Jung-gu","tip":"There's always a queue but it moves fast. The mandu (dumplings) are a must-order alongside the noodles.","priceLevel":"₩"}],"relatedSlugs":["best-bars-hongdae","cafes-gangnam"],"tags":["Street Food","Budget","Must Try"],"authorSlug":"mina-park","updatedDate":"2026-02-28","contentType":"guide"}}],["$","$L1d","cafes-gangnam",{"guide":{"slug":"cafes-gangnam","title":"Best Cafes In Gangnam","city":"seoul","category":"food","neighbourhood":"Gangnam","neighbourhoodSlug":"gangnam","priceRange":"₩₩","nearestMetro":"Gangnam (Line 2)","openingHours":"9 AM – 10 PM","image":"https://images.unsplash.com/photo-1559305616-3f99cd43e353?w=1200&q=80","summary":"Design-forward coffee shops and hidden gems south of the river.","intro":"Gangnam's cafe scene is all about aesthetics and quality. Multi-storey minimalist spaces, rooftop gardens, and some of Seoul's best specialty coffee — these are the ones worth crossing the river for.","venues":[{"name":"Fritz Coffee","image":"https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=600&q=80","description":"A beloved Seoul roastery with a cosy industrial interior and pastries baked fresh on-site. Their hand-drip coffee is consistently excellent.","address":"17 Dosan-daero 15-gil, Gangnam-gu","tip":"Try the einspänner — their version with house-made whipped cream is the best in Seoul.","priceLevel":"₩₩"}],"relatedSlugs":["best-street-food-myeongdong"],"tags":["Coffee","Design","Brunch"],"authorSlug":"mina-park","updatedDate":"2026-03-05","contentType":"guide"}}],["$","$L1d","hiking-bukhansan",{"guide":{"slug":"hiking-bukhansan","title":"Hiking Bukhansan National Park","city":"seoul","category":"things-to-do","neighbourhood":"Jongno","neighbourhoodSlug":"jamsil","priceRange":"Free","nearestMetro":"Gupabal (Line 3)","openingHours":"Sunrise – Sunset","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","summary":"Granite peaks and temple trails on the northern edge of Seoul.","intro":"Bukhansan is the dramatic granite mountain visible from almost anywhere in northern Seoul. Multiple trails wind through forests and past Buddhist temples to summit ridges with panoramic city views. It's one of the most visited national parks in the world — for good reason.","venues":[{"name":"Baegundae Peak Trail","image":"https://images.unsplash.com/photo-1551632811-561732d1e306?w=600&q=80","description":"The most popular trail to Bukhansan's highest point (836m). The final section involves steel cables and rock scrambling — exhilarating but not for the faint-hearted.","address":"Bukhansan National Park, Gangbuk-gu","tip":"Start before 7 AM on weekends to beat the crowds. Bring gloves for the cable section.","priceLevel":"Free"}],"relatedSlugs":["best-street-food-myeongdong"],"tags":["Hiking","Nature","Free"],"authorSlug":"mina-park","updatedDate":"2026-02-20","contentType":"guide"}}],["$","$L1d","streetwear-hongdae",{"guide":{"slug":"streetwear-hongdae","title":"Where to Shop for Streetwear in Hongdae","city":"seoul","category":"things-to-do","neighbourhood":"Hongdae","neighbourhoodSlug":"hongdae","priceRange":"₩₩ – ₩₩₩","nearestMetro":"Hongik University (Line 2)","openingHours":"11 AM – 9 PM","image":"https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=1200&q=80","summary":"The best streetwear and vintage shops in Hongdae — from local labels to thrift finds.","intro":"Hongdae's indie spirit shows in its fashion. Alongside global brands you'll find local designers, vintage stores and one-off pieces. Here are the spots worth hitting.","venues":[{"name":"Worksout","image":"https://images.unsplash.com/photo-1556821840-3a63f95609a7?w=600&q=80","description":"Korean streetwear brand with a flagship in Hongdae. Minimal cuts and limited drops.","address":"Wausan-ro 29na-gil, Mapo-gu","tip":"Check their Instagram for pop-ups and collabs.","priceLevel":"₩₩₩"},{"name":"Vintage Santa","image":"https://images.unsplash.com/photo-1558769132-cb1aeaede002?w=600&q=80","description":"Curated vintage and secondhand streetwear. Good for denim and graphic tees.","address":"Wausan-ro 21-gil, Mapo-gu","tip":"Go on a weekday for less crowd.","priceLevel":"₩₩"}],"relatedSlugs":["best-bars-hongdae","cafes-gangnam"],"tags":["Shopping","Streetwear","Vintage"],"authorSlug":"james-jeong","updatedDate":"2026-03-10","contentType":"guide"}}],["$","$L1d","pc-bang-gaming-seoul",{"guide":{"slug":"pc-bang-gaming-seoul","title":"Top PC Bang Internet Cafes in Seoul for Gaming","city":"seoul","category":"things-to-do","neighbourhood":"","neighbourhoodSlug":"","priceRange":"₩","nearestMetro":"Various","openingHours":"24 hours (most)","image":"https://images.unsplash.com/photo-1542751371-adc38448a05e?w=1200&q=80","summary":"Where to find the best PC bangs in Seoul — high-spec rigs, cheap hourly rates and a slice of Korean gaming culture.","intro":"PC bangs (PC rooms) are a staple of Korean youth culture. For a few thousand won an hour you get a high-end PC, fast internet and often free drinks. Here are solid options across Seoul.","venues":[{"name":"Nexon Arena","image":"https://images.unsplash.com/photo-1511512578047-dfb367046420?w=600&q=80","description":"Premium PC bang with top-tier hardware. Popular for League of Legends and FPS games.","address":"Gangnam-gu","tip":"Membership can save money if you're staying a while.","priceLevel":"₩"},{"name":"Challenger's League","image":"https://images.unsplash.com/photo-1542751371-adc38448a05e?w=600&q=80","description":"Chain PC bang with locations across Seoul. Clean, well-maintained and affordable.","address":"Multiple locations","tip":"Late night and early morning rates are often cheaper.","priceLevel":"₩"}],"relatedSlugs":["best-bars-hongdae","cafes-gangnam"],"tags":["Gaming","PC Bang","Culture"],"authorSlug":"james-jeong","updatedDate":"2026-03-10","contentType":"guide"}}]]}]]}],["$","section",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 pb-14","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-bold text-foreground mb-6","children":"Popular Venues"}],["$","div",null,{"className":"flex flex-col gap-3","children":[["$","$L7",null,{"href":"/south-korea/seoul/venues/cafe-abyss","className":"group flex gap-3 sm:gap-4 p-3 rounded-xl bg-card transition-all duration-200 hover:bg-secondary/50","style":{"boxShadow":"var(--shadow-card)"},"children":[["$","div",null,{"className":"w-20 h-20 sm:w-24 sm:h-24 rounded-lg overflow-hidden flex-shrink-0","children":["$","$L9",null,{"src":"https://images.unsplash.com/photo-1572116469696-31de0f17cc34?w=1200&q=80","alt":"Café Abyss","width":96,"height":96,"className":"w-full h-full object-cover transition-transform duration-500 group-hover:scale-105","loading":"lazy"}]}],["$","div",null,{"className":"flex-1 min-w-0","children":[["$","h3",null,{"className":"text-sm font-semibold text-foreground truncate","children":"Café Abyss"}],["$","p",null,{"className":"text-xs text-primary font-medium mt-0.5 capitalize","children":"bar"}],["$","p",null,{"className":"text-xs text-muted-foreground mt-1 line-clamp-2","children":"A moody, candlelit cocktail bar with an extensive whisky list and jazz playing low in the background."}],["$","div",null,{"className":"flex items-center gap-2 mt-1.5","children":[["$","span",null,{"className":"text-[10px] text-muted-foreground","children":"₩₩₩"}],["$","span",null,{"className":"text-[10px] text-muted-foreground","children":"·"}],["$","span",null,{"className":"text-[10px] text-muted-foreground","children":"hongdae"}]]}]]}]]}],["$","$L7",null,{"href":"/south-korea/seoul/venues/thursday-party","className":"