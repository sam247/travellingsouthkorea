2:["$","div",null,{"className":"min-h-screen bg-background","children":[["$","section",null,{"className":"relative h-[50vh] min-h-[350px] flex items-end overflow-hidden","children":[["$","$L9",null,{"src":"https://images.unsplash.com/photo-1617469767053-d3b523a0b982?w=1200&q=80","alt":"Seoul","fill":true,"className":"object-cover"}],["$","div",null,{"className":"absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"}],["$","div",null,{"className":"relative z-10 max-w-7xl mx-auto w-full px-4 sm:px-6 pb-8 sm:pb-12","children":[["$","h1",null,{"className":"text-3xl sm:text-5xl font-bold text-white","children":"Seoul"}],["$","p",null,{"className":"mt-2 text-base sm:text-lg text-white/80 max-w-xl font-editorial","children":"Province of South Korea"}]]}]]}],["$","section",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 pt-6","children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://travellingsouthkorea.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"South Korea\",\"item\":\"https://travellingsouthkorea.com/south-korea\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Seoul\"}]}"}}],["$","$La",null,{"children":["$","$Lb",null,{"children":[["$","$Lc","0",{"children":[false,["$","$Ld",null,{"asChild":true,"children":["$","$L7",null,{"href":"/","children":"Home"}]}]]}],["$","$Lc","1",{"children":[["$","$Le",null,{}],["$","$Ld",null,{"asChild":true,"children":["$","$L7",null,{"href":"/south-korea","children":"South Korea"}]}]]}],["$","$Lc","2",{"children":[["$","$Le",null,{}],["$","$Lf",null,{"children":"Seoul"}]]}]]}]}]],["$","p",null,{"className":"text-base sm:text-lg text-muted-foreground leading-relaxed max-w-2xl mt-6","children":"The capital metropolitan area — a megacity of 10 million blending ancient palaces, cutting-edge technology, world-class food and non-stop nightlife."}]]}],["$","section",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 py-10 sm:py-14","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-bold text-foreground mb-6","children":["Cities in ","Seoul"]}],["$","div",null,{"className":"grid grid-cols-1 sm:grid-cols-3 gap-5","children":[["$","$L10","seoul",{"city":{"slug":"seoul","name":"Seoul","tagline":"Where tradition meets neon","description":"South Korea's sprawling capital is a city of contrasts — ancient palaces sit beneath glass skyscrapers, street food alleys wind past Michelin-starred restaurants, and quiet temple grounds border the loudest nightlife districts in Asia.","image":"https://images.unsplash.com/photo-1617469767053-d3b523a0b982?w=1200&q=80","regionSlug":"seoul-metropolitan","lat":37.5665,"lng":126.978,"bestFor":["nightlife","food","shopping","culture"]}}]]}]]}],["$","section",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 pb-14","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-bold text-foreground mb-6","children":"Guides"}],["$","div",null,{"className":"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5","children":[["$","$L11","best-bars-hongdae",{"guide":{"slug":"best-bars-hongdae","title":"Best Bars In Hongdae","city":"seoul","category":"nightlife","neighbourhood":"Hongdae","neighbourhoodSlug":"hongdae","priceRange":"₩₩ – ₩₩₩","nearestMetro":"Hongik University (Line 2)","openingHours":"6 PM – 3 AM","image":"https://images.unsplash.com/photo-1514933651103-005eec06c04b?w=1200&q=80","summary":"From craft cocktails to soju dives — the definitive Hongdae bar guide.","intro":"Hongdae's bar scene is as eclectic as the neighbourhood itself. Graffiti-walled dives sit next to sleek cocktail lounges, and on any given night the energy spills from the venues onto the streets. Here are the spots worth your time.","venues":[{"name":"Café Abyss","image":"https://images.unsplash.com/photo-1572116469696-31de0f17cc34?w=600&q=80","description":"A moody, candlelit cocktail bar with an extensive whisky list and jazz playing low in the background. The bartenders here are serious about their craft.","address":"32-8 Wausan-ro 21-gil, Mapo-gu","tip":"Ask for the off-menu 'Midnight Seoul' cocktail — it's their signature and it's incredible.","priceLevel":"₩₩₩"},{"name":"Thursday Party","image":"https://images.unsplash.com/photo-1566417713940-fe7c737a9ef2?w=600&q=80","description":"The quintessential Hongdae dive bar. Cheap soju towers, loud music, and a crowd that's always up for a good time. Don't come here for quiet conversation.","address":"19-3 Wausan-ro 29na-gil, Mapo-gu","tip":"Thursday nights are obviously the busiest — go Wednesday for the same vibe with more space.","priceLevel":"₩"},{"name":"Vault 82","image":"https://images.unsplash.com/photo-1525268323446-0505b6fe7778?w=600&q=80","description":"A speakeasy-style bar hidden behind an unmarked door. The cocktail menu changes seasonally and the interior feels like stepping into a 1920s bank vault.","address":"82 Eoulmadang-ro, Mapo-gu","tip":"Ring the doorbell and wait — the entrance is intentionally hard to find. Look for the brass plate.","priceLevel":"₩₩₩"}],"relatedSlugs":["nightlife-itaewon","best-street-food-myeongdong"],"tags":["Bars","Cocktails","Nightlife"],"authorSlug":"james-jeong","updatedDate":"2026-03-10","contentType":"guide"}}],["$","$L11","nightlife-itaewon",{"guide":{"slug":"nightlife-itaewon","title":"Itaewon After Dark","city":"seoul","category":"nightlife","neighbourhood":"Itaewon","neighbourhoodSlug":"itaewon","priceRange":"₩₩ – ₩₩₩₩","nearestMetro":"Itaewon (Line 6)","openingHours":"8 PM – 5 AM","image":"https://images.unsplash.com/photo-1519608487953-e999c86e7455?w=1200&q=80","summary":"Seoul's most international nightlife district — rooftop bars, clubs and late-night eats.","intro":"Itaewon has always been Seoul's most cosmopolitan neighbourhood, and its nightlife reflects that. From rooftop cocktail bars overlooking the city to underground clubs playing everything from techno to K-pop, this is where Seoul stays up latest.","venues":[{"name":"Southside Parlor","image":"https://images.unsplash.com/photo-1470337458703-46ad1756a187?w=600&q=80","description":"A Southern-inspired whisky bar that feels like it was teleported from Nashville. Great bourbon selection and surprisingly good fried chicken.","address":"218 Noksapyeong-daero, Yongsan-gu","tip":"The upstairs terrace opens in spring and summer — get there early to grab a seat.","priceLevel":"₩₩₩"}],"relatedSlugs":["best-bars-hongdae"],"tags":["Clubs","Rooftop Bars","Late Night"],"authorSlug":"james-jeong","updatedDate":"2026-03-08","contentType":"guide"}}],["$","$L11","best-street-food-myeongdong",{"guide":{"slug":"best-street-food-myeongdong","title":"Best Street Food In Myeongdong","city":"seoul","category":"food","neighbourhood":"Myeongdong","neighbourhoodSlug":"myeongdong","priceRange":"₩","nearestMetro":"Myeongdong (Line 4)","openingHours":"11 AM – 10 PM","image":"https://images.unsplash.com/photo-1498654896293-37aacf113fd9?w=1200&q=80","summary":"Tteokbokki, hotteok, tornado potatoes — everything you need to eat on Myeongdong's food streets.","intro":"Myeongdong's main streets transform into an open-air food market every afternoon. Vendors line both sides selling everything from freshly grilled skewers to towering soft-serve ice cream. Come hungry.","venues":[{"name":"Myeongdong Kyoja","image":"https://images.unsplash.com/photo-1590301157890-4810ed352733?w=600&q=80","description":"A Myeongdong institution serving handmade kalguksu (knife-cut noodles) since 1966. The broth is rich and deeply savoury.","address":"29 Myeongdong 10-gil, Jung-gu","tip":"There's always a queue but it moves fast. The mandu (dumplings) are a must-order alongside the noodles.","priceLevel":"₩"}],"relatedSlugs":["best-bars-hongdae","cafes-gangnam"],"tags":["Street Food","Budget","Must Try"],"authorSlug":"mina-park","updatedDate":"2026-02-28","contentType":"guide"}}],["$","$L11","cafes-gangnam",{"guide":{"slug":"cafes-gangnam","title":"Best Cafes In Gangnam","city":"seoul","category":"food","neighbourhood":"Gangnam","neighbourhoodSlug":"gangnam","priceRange":"₩₩","nearestMetro":"Gangnam (Line 2)","openingHours":"9 AM – 10 PM","image":"https://images.unsplash.com/photo-1559305616-3f99cd43e353?w=1200&q=80","summary":"Design-forward coffee shops and hidden gems south of the river.","intro":"Gangnam's cafe scene is all about aesthetics and quality. Multi-storey minimalist spaces, rooftop gardens, and some of Seoul's best specialty coffee — these are the ones worth crossing the river for.","venues":[{"name":"Fritz Coffee","image":"https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=600&q=80","description":"A beloved Seoul roastery with a cosy industrial interior and pastries baked fresh on-site. Their hand-drip coffee is consistently excellent.","address":"17 Dosan-daero 15-gil, Gangnam-gu","tip":"Try the einspänner — their version with house-made whipped cream is the best in Seoul.","priceLevel":"₩₩"}],"relatedSlugs":["best-street-food-myeongdong"],"tags":["Coffee","Design","Brunch"],"authorSlug":"mina-park","updatedDate":"2026-03-05","contentType":"guide"}}],["$","$L11","hiking-bukhansan",{"guide":{"slug":"hiking-bukhansan","title":"Hiking Bukhansan National Park","city":"seoul","category":"things-to-do","neighbourhood":"Jongno","neighbourhoodSlug":"jamsil","priceRange":"Free","nearestMetro":"Gupabal (Line 3)","openingHours":"Sunrise – Sunset","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","summary":"Granite peaks and temple trails on the northern edge of Seoul.","intro":"Bukhansan is the dramatic granite mountain visible from almost anywhere in northern Seoul. Multiple trails wind through forests and past Buddhist temples to summit ridges with panoramic city views. It's one of the most visited national parks in the world — for good reason.","venues":[{"name":"Baegundae Peak Trail","image":"https://images.unsplash.com/photo-1551632811-561732d1e306?w=600&q=80","description":"The most popular trail to Bukhansan's highest point (836m). The final section involves steel cables and rock scrambling — exhilarating but not for the faint-hearted.","address":"Bukhansan National Park, Gangbuk-gu","tip":"Start before 7 AM on weekends to beat the crowds. Bring gloves for the cable section.","priceLevel":"Free"}],"relatedSlugs":["best-street-food-myeongdong"],"tags":["Hiking","Nature","Free"],"authorSlug":"mina-park","updatedDate":"2026-02-20","contentType":"guide"}}],["$","$L11","streetwear-hongdae",{"guide":{"slug":"streetwear-hongdae","title":"Where to Shop for Streetwear in Hongdae","city":"seoul","category":"things-to-do","neighbourhood":"Hongdae","neighbourhoodSlug":"hongdae","priceRange":"₩₩ – ₩₩₩","nearestMetro":"Hongik University (Line 2)","openingHours":"11 AM – 9 PM","image":"https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=1200&q=80","summary":"The best streetwear and vintage shops in Hongdae — from local labels to thrift finds.","intro":"Hongdae's indie spirit shows in its fashion. Alongside global brands you'll find local designers, vintage stores and one-off pieces. Here are the spots worth hitting.","venues":[{"name":"Worksout","image":"https://images.unsplash.com/photo-1556821840-3a63f95609a7?w=600&q=80","description":"Korean streetwear brand with a flagship in Hongdae. Minimal cuts and limited drops.","address":"Wausan-ro 29na-gil, Mapo-gu","tip":"Check their Instagram for pop-ups and collabs.","priceLevel":"₩₩₩"},{"name":"Vintage Santa","image":"https://images.unsplash.com/photo-1558769132-cb1aeaede002?w=600&q=80","description":"Curated vintage and secondhand streetwear. Good for denim and graphic tees.","address":"Wausan-ro 21-gil, Mapo-gu","tip":"Go on a weekday for less crowd.","priceLevel":"₩₩"}],"relatedSlugs":["best-bars-hongdae","cafes-gangnam"],"tags":["Shopping","Streetwear","Vintage"],"authorSlug":"james-jeong","updatedDate":"2026-03-10","contentType":"guide"}}],["$","$L11","pc-bang-gaming-seoul",{"guide":{"slug":"pc-bang-gaming-seoul","title":"Top PC Bang Internet Cafes in Seoul for Gaming","city":"seoul","category":"things-to-do","neighbourhood":"","neighbourhoodSlug":"","priceRange":"₩","nearestMetro":"Various","openingHours":"24 hours (most)","image":"https://images.unsplash.com/photo-1542751371-adc38448a05e?w=1200&q=80","summary":"Where to find the best PC bangs in Seoul — high-spec rigs, cheap hourly rates and a slice of Korean gaming culture.","intro":"PC bangs (PC rooms) are a staple of Korean youth culture. For a few thousand won an hour you get a high-end PC, fast internet and often free drinks. Here are solid options across Seoul.","venues":[{"name":"Nexon Arena","image":"https://images.unsplash.com/photo-1511512578047-dfb367046420?w=600&q=80","description":"Premium PC bang with top-tier hardware. Popular for League of Legends and FPS games.","address":"Gangnam-gu","tip":"Membership can save money if you're staying a while.","priceLevel":"₩"},{"name":"Challenger's League","image":"https://images.unsplash.com/photo-1542751371-adc38448a05e?w=600&q=80","description":"Chain PC bang with locations across Seoul. Clean, well-maintained and affordable.","address":"Multiple locations","tip":"Late night and early morning rates are often cheaper.","priceLevel":"₩"}],"relatedSlugs":["best-bars-hongdae","cafes-gangnam"],"tags":["Gaming","PC Bang","Culture"],"authorSlug":"james-jeong","updatedDate":"2026-03-10","contentType":"guide"}}]]}]]}]]}]
