2:["$","div",null,{"className":"min-h-screen bg-background","children":[["$","section",null,{"className":"pt-24 sm:pt-28 pb-6 sm:pb-8 max-w-7xl mx-auto px-4 sm:px-6","children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://travellingsouthkorea.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Things To Do\"}]}"}}],["$","$L9",null,{"children":["$","$La",null,{"children":[["$","$Lb","0",{"children":[false,["$","$Lc",null,{"asChild":true,"children":["$","$L7",null,{"href":"/","children":"Home"}]}]]}],["$","$Lb","1",{"children":[["$","$Ld",null,{}],["$","$Le",null,{"children":"Things To Do"}]]}]]}]}]],["$","h1",null,{"className":"text-3xl sm:text-4xl font-bold text-foreground mt-4","children":"Things To Do"}],["$","p",null,{"className":"text-muted-foreground mt-2","children":"Sights, hikes, culture and experiences"}]]}],["$","$Lf",null,{"mode":"guides","category":{"slug":"things-to-do","label":"Things To Do","description":"Sights, hikes, culture and experiences","filters":["All","Hiking","Culture","Free","Photography","Markets"]},"guides":[{"slug":"hiking-bukhansan","title":"Hiking Bukhansan National Park","city":"seoul","category":"things-to-do","neighbourhood":"Jongno","neighbourhoodSlug":"jamsil","priceRange":"Free","nearestMetro":"Gupabal (Line 3)","openingHours":"Sunrise – Sunset","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","summary":"Granite peaks and temple trails on the northern edge of Seoul.","intro":"Bukhansan is the dramatic granite mountain visible from almost anywhere in northern Seoul. Multiple trails wind through forests and past Buddhist temples to summit ridges with panoramic city views. It's one of the most visited national parks in the world — for good reason.","venues":[{"name":"Baegundae Peak Trail","image":"https://images.unsplash.com/photo-1551632811-561732d1e306?w=600&q=80","description":"The most popular trail to Bukhansan's highest point (836m). The final section involves steel cables and rock scrambling — exhilarating but not for the faint-hearted.","address":"Bukhansan National Park, Gangbuk-gu","tip":"Start before 7 AM on weekends to beat the crowds. Bring gloves for the cable section.","priceLevel":"Free"}],"relatedSlugs":["best-street-food-myeongdong"],"tags":["Hiking","Nature","Free"],"authorSlug":"mina-park","updatedDate":"2026-02-20","contentType":"guide"},{"slug":"haeundae-beach-guide","title":"Haeundae Beach Guide","city":"busan","category":"things-to-do","neighbourhood":"Haeundae","neighbourhoodSlug":"haeundae","priceRange":"₩ – ₩₩","nearestMetro":"Haeundae (Line 2)","openingHours":"All day","image":"https://images.unsplash.com/photo-1573057284059-827a26b093f4?w=1200&q=80","summary":"Everything you need to know about Busan's most famous beach.","intro":"Haeundae is the beach you've seen in every Korean drama. A wide crescent of sand backed by high-rises, it's the epicentre of Busan's summer scene. But there's more to it than sunbathing — the surrounding area is packed with seafood restaurants, markets, and cliff walks.","venues":[{"name":"Haeundae Traditional Market","image":"https://images.unsplash.com/photo-1567521464027-f127ff144326?w=600&q=80","description":"A bustling covered market a few blocks from the beach. Fresh seafood, dried fish, street snacks and local produce at great prices.","address":"Gunam-ro 41beon-gil, Haeundae-gu","tip":"Head to the second floor for some of the best (and cheapest) raw fish sets in Busan.","priceLevel":"₩"}],"relatedSlugs":[],"tags":["Beach","Seafood","Summer"],"authorSlug":"mina-park","updatedDate":"2026-03-12","contentType":"guide"},{"slug":"jeju-waterfalls","title":"Jeju's Best Waterfalls","city":"jeju","category":"things-to-do","neighbourhood":"Seogwipo","neighbourhoodSlug":"seogwipo","priceRange":"₩","nearestMetro":"N/A — drive or bus","openingHours":"9 AM – 6 PM","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","summary":"Cheonjiyeon, Jeongbang and the hidden cascades of Jeju's south coast.","intro":"Jeju's volcanic geology has created some spectacular waterfalls, most of them clustered along the island's southern coast near Seogwipo. From the famous Jeongbang — one of the only waterfalls in Asia that falls directly into the ocean — to quieter cascades hidden in forest gorges, these are the ones to visit.","venues":[{"name":"Jeongbang Waterfall","image":"https://images.unsplash.com/photo-1433086966358-54859d0ed716?w=600&q=80","description":"A 23-metre waterfall that plunges directly into the sea. The viewing platform gets you close enough to feel the spray.","address":"Jeongbang-dong, Seogwipo-si","tip":"Visit after rain for the most dramatic flow. The coast path east of here is beautiful and usually empty.","priceLevel":"₩"}],"relatedSlugs":["haeundae-beach-guide"],"tags":["Nature","Hiking","Photography"],"authorSlug":"mina-park","updatedDate":"2026-03-01","contentType":"guide"},{"slug":"streetwear-hongdae","title":"Where to Shop for Streetwear in Hongdae","city":"seoul","category":"things-to-do","neighbourhood":"Hongdae","neighbourhoodSlug":"hongdae","priceRange":"₩₩ – ₩₩₩","nearestMetro":"Hongik University (Line 2)","openingHours":"11 AM – 9 PM","image":"https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=1200&q=80","summary":"The best streetwear and vintage shops in Hongdae — from local labels to thrift finds.","intro":"Hongdae's indie spirit shows in its fashion. Alongside global brands you'll find local designers, vintage stores and one-off pieces. Here are the spots worth hitting.","venues":[{"name":"Worksout","image":"https://images.unsplash.com/photo-1556821840-3a63f95609a7?w=600&q=80","description":"Korean streetwear brand with a flagship in Hongdae. Minimal cuts and limited drops.","address":"Wausan-ro 29na-gil, Mapo-gu","tip":"Check their Instagram for pop-ups and collabs.","priceLevel":"₩₩₩"},{"name":"Vintage Santa","image":"https://images.unsplash.com/photo-1558769132-cb1aeaede002?w=600&q=80","description":"Curated vintage and secondhand streetwear. Good for denim and graphic tees.","address":"Wausan-ro 21-gil, Mapo-gu","tip":"Go on a weekday for less crowd.","priceLevel":"₩₩"}],"relatedSlugs":["best-bars-hongdae","cafes-gangnam"],"tags":["Shopping","Streetwear","Vintage"],"authorSlug":"james-jeong","updatedDate":"2026-03-10","contentType":"guide"},{"slug":"pc-bang-gaming-seoul","title":"Top PC Bang Internet Cafes in Seoul for Gaming","city":"seoul","category":"things-to-do","neighbourhood":"","neighbourhoodSlug":"","priceRange":"₩","nearestMetro":"Various","openingHours":"24 hours (most)","image":"https://images.unsplash.com/photo-1542751371-adc38448a05e?w=1200&q=80","summary":"Where to find the best PC bangs in Seoul — high-spec rigs, cheap hourly rates and a slice of Korean gaming culture.","intro":"PC bangs (PC rooms) are a staple of Korean youth culture. For a few thousand won an hour you get a high-end PC, fast internet and often free drinks. Here are solid options across Seoul.","venues":[{"name":"Nexon Arena","image":"https://images.unsplash.com/photo-1511512578047-dfb367046420?w=600&q=80","description":"Premium PC bang with top-tier hardware. Popular for League of Legends and FPS games.","address":"Gangnam-gu","tip":"Membership can save money if you're staying a while.","priceLevel":"₩"},{"name":"Challenger's League","image":"https://images.unsplash.com/photo-1542751371-adc38448a05e?w=600&q=80","description":"Chain PC bang with locations across Seoul. Clean, well-maintained and affordable.","address":"Multiple locations","tip":"Late night and early morning rates are often cheaper.","priceLevel":"₩"}],"relatedSlugs":["best-bars-hongdae","cafes-gangnam"],"tags":["Gaming","PC Bang","Culture"],"authorSlug":"james-jeong","updatedDate":"2026-03-10","contentType":"guide"}]}]]}]
