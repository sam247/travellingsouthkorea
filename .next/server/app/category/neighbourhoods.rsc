2:["$","div",null,{"className":"min-h-screen bg-background","children":[["$","section",null,{"className":"pt-24 sm:pt-28 pb-6 sm:pb-8 max-w-7xl mx-auto px-4 sm:px-6","children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://travellingsouthkorea.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Neighbourhoods\"}]}"}}],["$","$L9",null,{"children":["$","$La",null,{"children":[["$","$Lb","0",{"children":[false,["$","$Lc",null,{"asChild":true,"children":["$","$L7",null,{"href":"/","children":"Home"}]}]]}],["$","$Lb","1",{"children":[["$","$Ld",null,{}],["$","$Le",null,{"children":"Neighbourhoods"}]]}]]}]}]],["$","h1",null,{"className":"text-3xl sm:text-4xl font-bold text-foreground mt-4","children":"Neighbourhoods"}],["$","p",null,{"className":"text-muted-foreground mt-2","children":"Area guides and local insights"}]]}],["$","$Lf",null,{"mode":"neighbourhoods","category":{"slug":"neighbourhoods","label":"Neighbourhoods","description":"Area guides and local insights","filters":["All","Hip","Historic","Foodie","Nightlife"]},"neighbourhoods":[{"slug":"itaewon","name":"Itaewon","citySlug":"seoul","image":"https://images.unsplash.com/photo-1519608487953-e999c86e7455?w=1200&q=80","intro":"Seoul's most international neighbourhood. A melting pot of cultures with rooftop bars, global restaurants, vintage shops and some of the city's best nightlife. Itaewon has reinvented itself multiple times and remains one of Seoul's most dynamic areas.","nearestMetro":"Itaewon (Line 6)","vibe":"Cosmopolitan & eclectic","bestFor":["Nightlife","International food","Rooftop bars","Vintage shopping"],"priceRange":"₩₩ – ₩₩₩₩"},{"slug":"hongdae","name":"Hongdae","citySlug":"seoul","image":"https://images.unsplash.com/photo-1514933651103-005eec06c04b?w=1200&q=80","intro":"The beating heart of Seoul's indie culture. Named after Hongik University, this neighbourhood is defined by street performers, graffiti art, independent boutiques and a nightlife scene that runs until dawn. Always young, always loud.","nearestMetro":"Hongik University (Line 2)","vibe":"Creative & youthful","bestFor":["Bars","Live music","Street art","Shopping"],"priceRange":"₩ – ₩₩₩"},{"slug":"gangnam","name":"Gangnam","citySlug":"seoul","image":"https://images.unsplash.com/photo-1559305616-3f99cd43e353?w=1200&q=80","intro":"South of the river and famous worldwide thanks to a certain song. Gangnam is Seoul's business and luxury district — designer boutiques, upscale cafes, K-beauty clinics and some of the city's best restaurants hide behind glass facades.","nearestMetro":"Gangnam (Line 2)","vibe":"Upscale & polished","bestFor":["Cafes","Shopping","Fine dining","K-beauty"],"priceRange":"₩₩₩ – ₩₩₩₩"},{"slug":"myeongdong","name":"Myeongdong","citySlug":"seoul","image":"https://images.unsplash.com/photo-1498654896293-37aacf113fd9?w=1200&q=80","intro":"Seoul's ultimate shopping district and street food paradise. Myeongdong's neon-lit streets are packed with K-beauty stores, department stores and some of the best street food vendors in the city. Touristy but worth it.","nearestMetro":"Myeongdong (Line 4)","vibe":"Buzzing & commercial","bestFor":["Street food","Shopping","K-beauty","Tourism"],"priceRange":"₩ – ₩₩₩"},{"slug":"insadong","name":"Insadong","citySlug":"seoul","image":"https://images.unsplash.com/photo-1517154421773-0529f29ea451?w=1200&q=80","intro":"Seoul's cultural heart. Traditional teahouses, antique shops, art galleries and hanok alleyways make Insadong the place to experience old Korea in the middle of a modern city. Don't miss the Ssamziegil complex.","nearestMetro":"Anguk (Line 3)","vibe":"Traditional & artsy","bestFor":["Culture","Tea","Art galleries","Souvenirs"],"priceRange":"₩₩"},{"slug":"apgujeong","name":"Apgujeong","citySlug":"seoul","image":"https://images.unsplash.com/photo-1559305616-3f99cd43e353?w=1200&q=80","intro":"Seoul's most fashionable neighbourhood. Apgujeong Rodeo is where K-pop stars shop, where new restaurants open first and where Seoul's trend-conscious crowd comes to see and be seen.","nearestMetro":"Apgujeong Rodeo (Bundang Line)","vibe":"Trendy & luxurious","bestFor":["Fashion","Fine dining","People watching","K-pop culture"],"priceRange":"₩₩₩ – ₩₩₩₩"},{"slug":"jamsil","name":"Jamsil","citySlug":"seoul","image":"https://images.unsplash.com/photo-1617469767053-d3b523a0b982?w=1200&q=80","intro":"Home to Lotte World, the Olympic Park and Seoul's modern entertainment district. Jamsil combines family-friendly attractions with excellent shopping at Lotte World Mall and surprisingly good local food spots.","nearestMetro":"Jamsil (Line 2/8)","vibe":"Entertainment & family","bestFor":["Theme parks","Shopping","Sports","Lake walks"],"priceRange":"₩₩ – ₩₩₩"},{"slug":"garosu-gil","name":"Garosu-gil","citySlug":"seoul","image":"https://images.unsplash.com/photo-1559305616-3f99cd43e353?w=1200&q=80","intro":"Tree-lined street in Sinsa-dong famous for indie boutiques, design shops and cafes. A quieter, more refined alternative to Gangnam Station with a strong fashion and brunch scene.","nearestMetro":"Sinsa (Line 3)","vibe":"Trendy & leafy","bestFor":["Cafes","Fashion","Brunch","Design"],"priceRange":"₩₩₩"},{"slug":"seongsu","name":"Seongsu","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"The 'Brooklyn of Seoul'. Former shoe factories turned into cafes, galleries and concept stores. Seongsu has become the go-to area for creative types and specialty coffee.","nearestMetro":"Seongsu (Line 2)","vibe":"Industrial & creative","bestFor":["Cafes","Art","Shopping","Photo spots"],"priceRange":"₩₩ – ₩₩₩"},{"slug":"yeonnam","name":"Yeonnam","citySlug":"seoul","image":"https://images.unsplash.com/photo-1514933651103-005eec06c04b?w=1200&q=80","intro":"Just west of Hongdae, Yeonnam-dong offers a slightly calmer vibe with hip cafes, small galleries and the popular Yeontral Park. A favourite for brunch and casual hangs.","nearestMetro":"Hongik University (Line 2)","vibe":"Relaxed & hip","bestFor":["Cafes","Brunch","Parks","Walking"],"priceRange":"₩₩ – ₩₩₩"},{"slug":"hannam","name":"Hannam","citySlug":"seoul","image":"https://images.unsplash.com/photo-1519608487953-e999c86e7455?w=1200&q=80","intro":"Upscale residential area between Itaewon and Hannam-dong. Low-key luxury, international schools and some of Seoul's best low-profile restaurants and wine bars.","nearestMetro":"Hannam (Gyeongui–Jungang Line)","vibe":"Understated & upscale","bestFor":["Fine dining","Wine bars","Quiet cafes"],"priceRange":"₩₩₩ – ₩₩₩₩"},{"slug":"samcheong","name":"Samcheong","citySlug":"seoul","image":"https://images.unsplash.com/photo-1517154421773-0529f29ea451?w=1200&q=80","intro":"Hanok-lined streets between Gyeongbokgung and Bukchon. Traditional tea houses, small museums and galleries with views of the palace and mountains.","nearestMetro":"Anguk (Line 3)","vibe":"Traditional & quiet","bestFor":["Culture","Tea","Palace views","Walking"],"priceRange":"₩₩ – ₩₩₩"},{"slug":"bukchon","name":"Bukchon","citySlug":"seoul","image":"https://images.unsplash.com/photo-1517154421773-0529f29ea451?w=1200&q=80","intro":"Bukchon Hanok Village preserves hundreds of traditional houses. Wander the alleys, try on hanbok or join a craft workshop. One of Seoul's most photogenic neighbourhoods.","nearestMetro":"Anguk (Line 3)","vibe":"Traditional & photogenic","bestFor":["Hanok","Culture","Photography","Workshops"],"priceRange":"₩₩"},{"slug":"namdaemun","name":"Namdaemun","citySlug":"seoul","image":"https://images.unsplash.com/photo-1498654896293-37aacf113fd9?w=1200&q=80","intro":"Home to Namdaemun Market, Korea's largest traditional market. Open 24/7 with clothing, souvenirs, street food and local produce. A no-frills, authentic Seoul experience.","nearestMetro":"Hoehyeon (Line 4)","vibe":"Busy & traditional","bestFor":["Markets","Street food","Souvenirs","Bargains"],"priceRange":"₩ – ₩₩"},{"slug":"sinchon","name":"Sinchon","citySlug":"seoul","image":"https://images.unsplash.com/photo-1514933651103-005eec06c04b?w=1200&q=80","intro":"University district near Yonsei and Ewha. Young crowd, affordable eats, karaoke and shopping. Lively day and night with a student-friendly vibe.","nearestMetro":"Sinchon (Line 2)","vibe":"Young & energetic","bestFor":["Food","Shopping","Karaoke","Nightlife"],"priceRange":"₩ – ₩₩"},{"slug":"gangnam-station-area","name":"Gangnam Station Area","citySlug":"seoul","image":"https://images.unsplash.com/photo-1559305616-3f99cd43e353?w=1200&q=80","intro":"The hub around Gangnam Station. Dense mix of offices, shops, cafes and nightlife. Underground shopping, exit-linked malls and 24-hour energy.","nearestMetro":"Gangnam (Line 2)","vibe":"Busy & commercial","bestFor":["Shopping","Nightlife","Cafes","Convenience"],"priceRange":"₩₩ – ₩₩₩₩"},{"slug":"coex","name":"COEX","citySlug":"seoul","image":"https://images.unsplash.com/photo-1617469767053-d3b523a0b982?w=1200&q=80","intro":"COEX Mall and Starfield: one of Asia's largest underground malls. Aquarium, library, cinema and events. Part of the Samseong business and convention district.","nearestMetro":"Samseong (Line 2)","vibe":"Modern & mega-scale","bestFor":["Shopping","Aquarium","Events","Convenience"],"priceRange":"₩₩ – ₩₩₩"},{"slug":"apgujeong-rodeo","name":"Apgujeong Rodeo","citySlug":"seoul","image":"https://images.unsplash.com/photo-1559305616-3f99cd43e353?w=1200&q=80","intro":"The high-fashion strip of Apgujeong. Designer flagships, celebrity spotting and the original Rodeo Street. Glamorous and people-watching central.","nearestMetro":"Apgujeong Rodeo (Bundang Line)","vibe":"Luxury & glamour","bestFor":["Fashion","Luxury shopping","People watching"],"priceRange":"₩₩₩₩"},{"slug":"gangdong","name":"Gangdong","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Eastern Seoul across the Han. Residential, green and home to Olympic Park extension, Amsa-dong prehistoric site and riverside parks.","nearestMetro":"Gangdong (Line 5)","vibe":"Green & residential","bestFor":["Parks","History","Riverside"],"priceRange":"₩₩"},{"slug":"gangbuk","name":"Gangbuk","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"North of the Han River. Mix of older residential neighbourhoods, universities and historic sites. More laid-back than the south.","nearestMetro":"Dobong (Line 1/7)","vibe":"Residential & calm","bestFor":["Local life","Parks","History"],"priceRange":"₩ – ₩₩"},{"slug":"gangseo","name":"Gangseo","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Western Seoul. Gimpo Airport access, Magok, and a growing business and tech corridor. Mix of industry and new development.","nearestMetro":"Magok (Line 5)","vibe":"Sprawling & practical","bestFor":["Transport","Business","Parks"],"priceRange":"₩₩"},{"slug":"gwanak","name":"Gwanak","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Home to Seoul National University. Student area with affordable food and nightlife, plus Gwanak Mountain hiking and parks.","nearestMetro":"Seoul National University (Line 2)","vibe":"Academic & affordable","bestFor":["Hiking","Food","Student vibe"],"priceRange":"₩ – ₩₩"},{"slug":"gwangjin","name":"Gwangjin","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Eastern district with Konkuk University area, Children's Grand Park and the growing Seongsu cafe and creative scene.","nearestMetro":"Konkuk University (Line 2/7)","vibe":"Young & creative","bestFor":["Cafes","Parks","Nightlife"],"priceRange":"₩ – ₩₩₩"},{"slug":"guro","name":"Guro","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Southwestern district. Guro Digital Complex, tech offices and affordable dining. Practical and less touristy.","nearestMetro":"Guro Digital Complex (Line 2)","vibe":"Industrial & practical","bestFor":["Tech","Affordable food","Shopping"],"priceRange":"₩ – ₩₩"},{"slug":"geumcheon","name":"Geumcheon","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Southern district with a mix of residential and light industry. Affordable and well connected by Line 1 and 7.","nearestMetro":"Geumcheon-gu Office (Line 1)","vibe":"Residential & local","bestFor":["Local life","Affordable eats"],"priceRange":"₩"},{"slug":"dobong","name":"Dobong","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Northern Seoul. Dobong Mountain and Bukhansan access. Hiking, temples and a quieter residential feel.","nearestMetro":"Dobong (Line 1/7)","vibe":"Nature & residential","bestFor":["Hiking","Temples","Nature"],"priceRange":"₩ – ₩₩"},{"slug":"dongdaemun","name":"Dongdaemun","citySlug":"seoul","image":"https://images.unsplash.com/photo-1498654896293-37aacf113fd9?w=1200&q=80","intro":"Dongdaemun Design Plaza and the famous 24-hour wholesale and retail markets. Fashion, fabrics and street food in a landmark district.","nearestMetro":"Dongdaemun (Line 1/4)","vibe":"24/7 & commercial","bestFor":["Shopping","Markets","Architecture","Street food"],"priceRange":"₩ – ₩₩₩"},{"slug":"dongjak","name":"Dongjak","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"South of the river. Noryangjin Fish Market, Sadang area and access to the Han. Mix of markets and residential.","nearestMetro":"Noryangjin (Line 1/9)","vibe":"Markets & local","bestFor":["Seafood","Markets","Han River"],"priceRange":"₩ – ₩₩"},{"slug":"eunpyeong","name":"Eunpyeong","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Northwestern Seoul. Jingwansa Temple, Bukhansan foothills and a growing cafe scene in Gusan-dong. Calm and green.","nearestMetro":"Gusan (Gyeongui–Jungang Line)","vibe":"Temple & nature","bestFor":["Temples","Hiking","Cafes"],"priceRange":"₩ – ₩₩"},{"slug":"jongno","name":"Jongno","citySlug":"seoul","image":"https://images.unsplash.com/photo-1517154421773-0529f29ea451?w=1200&q=80","intro":"Historic heart of Seoul. Gyeongbokgung, Changdeokgung, Jongmyo and Insadong. Palaces, museums and traditional culture.","nearestMetro":"Jongno 3-ga (Line 1/3/5)","vibe":"Historic & cultural","bestFor":["Palaces","Museums","Culture","Walking"],"priceRange":"₩ – ₩₩₩"},{"slug":"jung","name":"Jung","citySlug":"seoul","image":"https://images.unsplash.com/photo-1498654896293-37aacf113fd9?w=1200&q=80","intro":"Central district. Myeongdong, Namdaemun, City Hall and N Seoul Tower. The core of downtown shopping and landmarks.","nearestMetro":"Myeongdong (Line 4)","vibe":"Downtown & landmark","bestFor":["Shopping","Landmarks","Street food","Views"],"priceRange":"₩ – ₩₩₩"},{"slug":"jungnang","name":"Jungnang","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Eastern Seoul. Residential and green with Jungnang Stream and parks. Quiet and family-oriented.","nearestMetro":"Jungnang (Gyeongui–Jungang Line)","vibe":"Residential & green","bestFor":["Parks","Local life"],"priceRange":"₩ – ₩₩"},{"slug":"mapo","name":"Mapo","citySlug":"seoul","image":"https://images.unsplash.com/photo-1514933651103-005eec06c04b?w=1200&q=80","intro":"Home to Hongdae, Yeonnam and the Han River parks. Youth culture, indie music and some of Seoul's best nightlife and cafes.","nearestMetro":"Hongik University (Line 2)","vibe":"Youth & culture","bestFor":["Nightlife","Cafes","Parks","Music"],"priceRange":"₩ – ₩₩₩"},{"slug":"nowon","name":"Nowon","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Northeastern Seoul. Dense residential area with good transport, local markets and access to Suraksan and Dobongsan.","nearestMetro":"Nowon (Line 4/7)","vibe":"Residential & practical","bestFor":["Local life","Hiking","Markets"],"priceRange":"₩ – ₩₩"},{"slug":"seocho","name":"Seocho","citySlug":"seoul","image":"https://images.unsplash.com/photo-1559305616-3f99cd43e353?w=1200&q=80","intro":"South of the river. Gangnam Station, Seocho office district and a mix of business, shopping and dining. Central to the Gangnam area.","nearestMetro":"Seocho (Line 2)","vibe":"Business & upscale","bestFor":["Business","Shopping","Dining"],"priceRange":"₩₩ – ₩₩₩₩"},{"slug":"seodaemun","name":"Seodaemun","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Northwestern Seoul. Independence Park, Seodaemun Prison History Hall and Ewha Womans University area. History and student life.","nearestMetro":"Dongnimmun (Line 3)","vibe":"History & campus","bestFor":["History","Universities","Parks"],"priceRange":"₩ – ₩₩"},{"slug":"seongdong","name":"Seongdong","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Eastern district. Seongsu's cafes and creative scene, plus Wangsimni transport hub. A blend of industry and trendiness.","nearestMetro":"Seongsu (Line 2)","vibe":"Creative & mixed","bestFor":["Cafes","Seongsu","Transport"],"priceRange":"₩ – ₩₩₩"},{"slug":"seongbuk","name":"Seongbuk","citySlug":"seoul","image":"https://images.unsplash.com/photo-1517154421773-0529f29ea451?w=1200&q=80","intro":"Northern Seoul. Bukhan Mountain foothills, traditional villages and a quieter, older-Seoul feel. Good for temples and walks.","nearestMetro":"Hansung University (Line 4)","vibe":"Traditional & quiet","bestFor":["Temples","Walking","Local life"],"priceRange":"₩ – ₩₩"},{"slug":"songpa","name":"Songpa","citySlug":"seoul","image":"https://images.unsplash.com/photo-1617469767053-d3b523a0b982?w=1200&q=80","intro":"Southeastern Seoul. Jamsil, Lotte World, Olympic Park and the Han River. Family attractions, sports and modern development.","nearestMetro":"Jamsil (Line 2/8)","vibe":"Entertainment & family","bestFor":["Theme parks","Sports","Parks","Shopping"],"priceRange":"₩₩ – ₩₩₩"},{"slug":"yangcheon","name":"Yangcheon","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Southwestern Seoul. Mok-dong residential area and Yangcheon Park. Family-oriented and well connected.","nearestMetro":"Mok-dong (Line 5)","vibe":"Residential & family","bestFor":["Parks","Local life"],"priceRange":"₩ – ₩₩"},{"slug":"yeongdeungpo","name":"Yeongdeungpo","citySlug":"seoul","image":"https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80","intro":"Major commercial hub on the south side. Yeouido, Times Square and financial district. Business, shopping and Han River access.","nearestMetro":"Yeongdeungpo (Line 1/2)","vibe":"Business & commercial","bestFor":["Business","Shopping","Yeouido","Han River"],"priceRange":"₩₩ – ₩₩₩"},{"slug":"yongsan","name":"Yongsan","citySlug":"seoul","image":"https://images.unsplash.com/photo-1519608487953-e999c86e7455?w=1200&q=80","intro":"Central district spanning Itaewon, Hannam and Yongsan Station. International vibe, embassies, museums and the huge Yongsan Electronics Market.","nearestMetro":"Itaewon (Line 6)","vibe":"International & mixed","bestFor":["Nightlife","Itaewon","Electronics","Museums"],"priceRange":"₩ – ₩₩₩₩"},{"slug":"haeundae","name":"Haeundae","citySlug":"busan","image":"https://images.unsplash.com/photo-1573057284059-827a26b093f4?w=1200&q=80","intro":"Busan's most famous beach neighbourhood. A wide crescent of sand backed by skyscrapers, with seafood restaurants, night markets and the stunning Haedong Yonggungsa temple nearby.","nearestMetro":"Haeundae (Line 2)","vibe":"Beachy & lively","bestFor":["Beach","Seafood","Nightlife","Coastal walks"],"priceRange":"₩₩ – ₩₩₩"},{"slug":"seogwipo","name":"Seogwipo","citySlug":"jeju","image":"https://images.unsplash.com/photo-1600002415506-dd06090d3480?w=1200&q=80","intro":"Jeju's southern city is the gateway to the island's most dramatic scenery — waterfalls, volcanic coastlines, citrus orchards and the Olle hiking trails. Quieter and more scenic than Jeju City.","nearestMetro":"N/A — drive or bus","vibe":"Scenic & relaxed","bestFor":["Waterfalls","Hiking","Nature","Cafes"],"priceRange":"₩ – ₩₩"}]}]]}]
