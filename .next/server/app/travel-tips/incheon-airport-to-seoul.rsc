":["$","$L9",null,{"src":"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&q=80","alt":"James Jeong","width":32,"height":32,"className":"w-8 h-8 rounded-full object-cover"}]}],["$","div",null,{"className":"text-sm","children":[["$","$L7",null,{"href":"/authors/james-jeong","className":"font-medium text-foreground hover:text-primary transition-colors","children":"James Jeong"}],["$","span",null,{"className":"text-muted-foreground","children":[" · Updated ","March 2026"]}]]}]]}]]}],["$","section",null,{"className":"max-w-4xl mx-auto px-4 sm:px-6 py-6","children":["$","div",null,{"className":"flex flex-wrap gap-2","children":[["$","span","Transport",{"className":"text-xs font-medium px-2.5 py-1 rounded-full bg-primary/10 text-primary","children":"Transport"}],["$","span","Airport",{"className":"text-xs font-medium px-2.5 py-1 rounded-full bg-primary/10 text-primary","children":"Airport"}],["$","span","Seoul",{"className":"text-xs font-medium px-2.5 py-1 rounded-full bg-primary/10 text-primary","children":"Seoul"}],["$","span","Practical",{"className":"text-xs font-medium px-2.5 py-1 rounded-full bg-primary/10 text-primary","children":"Practical"}]]}]}],["$","section",null,{"className":"max-w-4xl mx-auto px-4 sm:px-6 pb-14","children":["$","div",null,{"className":"prose prose-neutral dark:prose-invert max-w-none","children":[["$","h2","0",{"className":"text-lg sm:text-xl font-bold text-foreground mt-8 mb-3","children":"Getting From Incheon To Seoul"}],["$","p","2",{"className":"text-sm sm:text-base text-muted-foreground leading-relaxed mb-3","children":"Incheon International Airport (ICN) is about 60km west of central Seoul. Here are your options, ranked."}],["$","h2","4",{"className":"text-lg sm:text-xl font-bold text-foreground mt-8 mb-3","children":"AREX (Airport Railroad Express)"}],["$","p","6",{"className":"text-sm sm:text-base text-muted-foreground leading-relaxed mb-3","children":"**Best for most travellers.** The express train takes 43 minutes non-stop to Seoul Station. Costs ₩9,500. Trains run every 30-40 minutes."}],["$","p","8",{"className":"text-sm sm:text-base text-muted-foreground leading-relaxed mb-3","children":"The all-stop version takes about 58 minutes and costs ₩4,750. Both accept T-Money cards."}],["$","h2","10",{"className":"text-lg sm:text-xl font-bold text-foreground mt-8 mb-3","children":"Airport Limousine Bus"}],["$","p","12",{"className":"text-sm sm:text-base text-muted-foreground leading-relaxed mb-3","children":"Comfortable buses run to most major areas of Seoul — Gangnam, Myeongdong, Hongdae, Itaewon. Costs ₩10,000-17,000 depending on destination. Takes 60-90 minutes depending on traffic."}],["$","h2","14",{"className":"text-lg sm:text-xl font-bold text-foreground mt-8 mb-3","children":"Taxi"}],["$","p","16",{"className":"text-sm sm:text-base text-muted-foreground leading-relaxed mb-3","children":"A regular taxi to central Seoul costs ₩65,000-80,000 and takes 60-90 minutes. Deluxe (black) taxis cost more but are more comfortable. Use KakaoTaxi app to avoid language issues."}],["$","h2","18",{"className":"text-lg sm:text-xl font-bold text-foreground mt-8 mb-3","children":"KTX (High-Speed Rail)"}],["$","p","20",{"className":"text-sm sm:text-base text-muted-foreground leading-relaxed mb-3","children":"If heading to Busan or other cities, you can catch the KTX directly from Incheon Airport. Book through the Korail app."}],["$","h2","22",{"className":"text-lg sm:text-xl font-bold text-foreground mt-8 mb-3","children":"Our Recommendation"}],["$","p","24",{"className":"text-sm sm:text-base text-muted-foreground leading-relaxed mb-3","children":"Take the AREX Express to Seoul Station, then transfer to the subway. It's the fastest, cheapest and most reliable option."}]]}]}],["$","section",null,{"className":"max-w-4xl mx-auto px-4 sm:px-6 pb-14","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-bold text-foreground mb-6","children":"Related Tips"}],["$","div",null,{"className"