2:["$","div",null,{"className":"min-h-screen bg-background","children":[["$","div",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 pt-6 pb-2","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://travellingsouthkorea.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Seoul\",\"item\":\"https://travellingsouthkorea.com/south-korea/seoul\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Map\"}]}"}}],["$","$L9",null,{"children":["$","$La",null,{"children":[["$","$Lb","0",{"children":[false,["$","$Lc",null,{"asChild":true,"children":["$","$L7",null,{"href":"/","children":"Home"}]}]]}],["$","$Lb","1",{"children":[["$","$Ld",null,{}],["$","$Lc",null,{"asChild":true,"children":["$","$L7",null,{"href":"/south-korea/seoul","children":"Seoul"}]}]]}],["$","$Lb","2",{"children":[["$","$Ld",null,{}],["$","$Le",null,{"children":"Map"}]]}]]}]}]]}],["$","$Lf",null,{"cityName":"Seoul","citySlug":"seoul","venues":[{"slug":"cafe-abyss","name":"Café Abyss","citySlug":"seoul","neighbourhoodSlug":"hongdae","category":"bar","image":"https://images.unsplash.com/photo-1572116469696-31de0f17cc34?w=1200&q=80","description":"A moody, candlelit cocktail bar with an extensive whisky list and jazz playing low in the background.","address":"32-8 Wausan-ro 21-gil, Mapo-gu","nearestMetro":"Hongik University (Line 2)","priceLevel":"₩₩₩","openingHours":"6 PM – 2 AM","overview":"Café Abyss is one of Hongdae's best-kept secrets — a candlelit cocktail bar hidden on a quiet side street. The bartenders are serious about their craft, with an extensive whisky collection and seasonal cocktail menus that change quarterly.","whyVisit":"The 'Midnight Seoul' off-menu cocktail is their signature — a smoky, complex blend that perfectly captures the city's late-night energy. The jazz soundtrack and dim lighting make this the ideal spot for a slow, considered evening drink.","tips":["Ask for the off-menu 'Midnight Seoul' cocktail — it's their signature.","Arrive before 8 PM on weekends to guarantee a seat.","The upstairs loft area is quieter and more intimate."],"lat":37.5563,"lng":126.9236,"contentType":"venue"},{"slug":"thursday-party","name":"Thursday Party","citySlug":"seoul","neighbourhoodSlug":"hongdae","category":"bar","image":"https://images.unsplash.com/photo-1566417713940-fe7c737a9ef2?w=1200&q=80","description":"The quintessential Hongdae dive bar. Cheap soju towers, loud music and a crowd that's always up for a good time.","address":"19-3 Wausan-ro 29na-gil, Mapo-gu","nearestMetro":"Hongik University (Line 2)","priceLevel":"₩","openingHours":"7 PM – 4 AM","overview":"Thursday Party is what Hongdae nightlife is all about — no pretension, cheap drinks, loud music and a crowd of students and travellers ready to party. It's been a neighbourhood institution for years.","whyVisit":"This is the authentic Hongdae dive bar experience. Soju towers, beer pong, and the kind of chaotic energy that makes for the best nights out. Perfect starting point before hitting the clubs.","tips":["Thursday nights are obviously the busiest — go Wednesday for the same vibe with more space.","The soju tower is the best value order.","Don't bring valuables — it gets rowdy."],"lat":37.5571,"lng":126.9249,"contentType":"venue"},{"slug":"vault-82","name":"Vault 82","citySlug":"seoul","neighbourhoodSlug":"hongdae","category":"bar","image":"https://images.unsplash.com/photo-1525268323446-0505b6fe7778?w=1200&q=80","description":"A speakeasy-style bar hidden behind an unmarked door with a seasonally changing cocktail menu.","address":"82 Eoulmadang-ro, Mapo-gu","nearestMetro":"Hongik University (Line 2)","priceLevel":"₩₩₩","openingHours":"7 PM – 3 AM","overview":"Vault 82 channels 1920s prohibition-era aesthetics with a modern Korean twist. Behind an unmarked door, you'll find exposed brick, brass fixtures and bartenders who take their craft as seriously as any in Seoul.","whyVisit":"The interior alone is worth the visit — stepping through the heavy door feels like entering another era. The seasonal cocktail menu always features at least two Korean-ingredient specials that you won't find anywhere else.","tips":["Ring the doorbell and wait — the entrance is intentionally hard to find.","Look for the brass plate next to a nondescript wooden door.","Reservations recommended for groups of 4+."],"lat":37.5548,"lng":126.9218,"contentType":"venue"},{"slug":"southside-parlor","name":"Southside Parlor","citySlug":"seoul","neighbourhoodSlug":"itaewon","category":"bar","image":"https://images.unsplash.com/photo-1470337458703-46ad1756a187?w=1200&q=80","description":"A Southern-inspired whisky bar with great bourbon selection and surprisingly good fried chicken.","address":"218 Noksapyeong-daero, Yongsan-gu","nearestMetro":"Itaewon (Line 6)","priceLevel":"₩₩₩","openingHours":"5 PM – 2 AM","overview":"Southside Parlor brings Nashville to Seoul. Exposed brick, leather booths, an extensive bourbon wall and Southern comfort food that actually delivers. It's become one of Itaewon's most reliable spots for a quality evening out.","whyVisit":"The bourbon collection is one of the best in Seoul, and the fried chicken rivals dedicated Korean fried chicken joints. The terrace in spring and summer is unbeatable.","tips":["The upstairs terrace opens in spring and summer — get there early to grab a seat.","The Nashville hot chicken sandwich is a must-order.","Happy hour is 5-7 PM with discounted bourbon pours."],"lat":37.534,"lng":126.987,"contentType":"venue"},{"slug":"myeongdong-kyoja","name":"Myeongdong Kyoja","citySlug":"seoul","neighbourhoodSlug":"myeongdong","category":"restaurant","image":"https://images.unsplash.com/photo-1590301157890-4810ed352733?w=1200&q=80","description":"A Myeongdong institution serving handmade kalguksu (knife-cut noodles) since 1966.","address":"29 Myeongdong 10-gil, Jung-gu","nearestMetro":"Myeongdong (Line 4)","priceLevel":"₩","openingHours":"10:30 AM – 9:30 PM","overview":"Myeongdong Kyoja has been serving the same perfected kalguksu recipe since 1966. The broth is rich and deeply savoury, the hand-cut noodles have the perfect chew, and the mandu dumplings are legendary.","whyVisit":"This is living Seoul food history. The recipe hasn't changed in nearly 60 years because it doesn't need to. The simplicity and consistency are what make it extraordinary.","tips":["There's always a queue but it moves fast — rarely more than 15 minutes.","The mandu (dumplings) are a must-order alongside the noodles.","Cash only — there's an ATM in the convenience store next door."],"lat":37.5636,"lng":126.9851,"contentType":"venue"},{"slug":"fritz-coffee","name":"Fritz Coffee","citySlug":"seoul","neighbourhoodSlug":"gangnam","category":"cafe","image":"https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=1200&q=80","description":"A beloved Seoul roastery with a cosy industrial interior and pastries baked fresh on-site.","address":"17 Dosan-daero 15-gil, Gangnam-gu","nearestMetro":"Gangnam (Line 2)","priceLevel":"₩₩","openingHours":"9 AM – 10 PM","overview":"Fritz Coffee is one of Seoul's original specialty coffee pioneers. Their Mapo-gu roastery has spawned multiple locations, but the Gangnam branch captures the same warm industrial aesthetic with consistently excellent hand-drip coffee and fresh pastries.","whyVisit":"The einspänner with house-made whipped cream is the best in Seoul — rich, balanced, and perfectly executed. The bakery puts out fresh batches throughout the day, and the space itself is a masterclass in Korean cafe design.","tips":["Try the einspänner — their version with house-made whipped cream is the best in Seoul.","The cinnamon roll sells out by early afternoon.","Window seats on the second floor are the best spots."],"lat":37.5172,"lng":127.0286,"contentType":"venue"},{"slug":"baegundae-peak","name":"Baegundae Peak Trail","citySlug":"seoul","neighbourhoodSlug":"jamsil","category":"attraction","image":"https://images.unsplash.com/photo-1551632811-561732d1e306?w=1200&q=80","description":"The most popular trail to Bukhansan's highest point at 836 metres with panoramic city views.","address":"Bukhansan National Park, Gangbuk-gu","nearestMetro":"Gupabal (Line 3)","priceLevel":"Free","openingHours":"Sunrise – Sunset","overview":"Baegundae Peak is the crown jewel of Bukhansan National Park — Seoul's dramatic granite mountain visible from almost anywhere in the northern city. The trail winds through pine forests, past Buddhist temples and up rocky ridges to a summit with 360-degree views.","whyVisit":"Standing on the summit of Baegundae with Seoul spread out below you is one of the city's defining experiences. The final scramble up steel cables adds genuine adventure to what's otherwise a well-maintained trail.","tips":["Start before 7 AM on weekends to beat the crowds.","Bring gloves for the cable section near the summit.","The Bukhansanseong trail entrance is less crowded than the main Dobongsan route."],"lat":37.6592,"lng":126.9772,"contentType":"venue"},{"slug":"cakeshop-club","name":"Cakeshop","citySlug":"seoul","neighbourhoodSlug":"itaewon","category":"club","image":"https://images.unsplash.com/photo-1566417713940-fe7c737a9ef2?w=1200&q=80","description":"Seoul's most respected underground club. Techno, house and experimental electronic music in a sweaty basement.","address":"134 Itaewon-ro, Yongsan-gu","nearestMetro":"Itaewon (Line 6)","priceLevel":"₩₩","openingHours":"10 PM – 6 AM (Fri-Sat)","overview":"Cakeshop is the beating heart of Seoul's underground electronic music scene. This basement club in Itaewon has hosted some of the best DJs in Asia and regularly brings in international acts. The sound system is impeccable and the crowd knows their music.","whyVisit":"If you care about electronic music, Cakeshop is a pilgrimage. The programming is consistently excellent — techno, house, experimental — and the intimate basement setting creates an intensity that larger clubs can't match.","tips":["Check their Instagram for the weekly lineup before going.","Arrive after midnight for the best atmosphere.","The bar upstairs (Contra) is a good warm-up spot."],"lat":37.5345,"lng":126.9915,"contentType":"venue"},{"slug":"tosokchon","name":"Tosokchon Samgyetang","citySlug":"seoul","neighbourhoodSlug":"insadong","category":"restaurant","image":"https://images.unsplash.com/photo-1590301157890-4810ed352733?w=1200&q=80","description":"Seoul's most famous samgyetang (ginseng chicken soup) restaurant, near Gyeongbokgung Palace.","address":"5 Jahamun-ro 5-gil, Jongno-gu","nearestMetro":"Gyeongbokgung (Line 3)","priceLevel":"₩₩","openingHours":"10 AM – 10 PM","overview":"Tosokchon has been serving samgyetang — whole young chicken stuffed with glutinous rice, ginseng, jujubes and garlic, simmered for hours — since 1983. The queue outside is a Seoul landmark in itself.","whyVisit":"This is the definitive samgyetang experience. The broth is rich and restorative, the chicken falls apart at the touch of chopsticks, and eating it near the palace feels like a proper Seoul ritual.","tips":["Go at 10 AM when they open to avoid the lunch queue.","The black chicken version is worth the premium.","Pair it with the bokbunja (raspberry wine) for the full experience."],"lat":37.5788,"lng":126.9711,"contentType":"venue"},{"slug":"zapangi","name":"Zapangi","citySlug":"seoul","neighbourhoodSlug":"gangnam","category":"cafe","image":"https://images.unsplash.com/photo-1559305616-3f99cd43e353?w=1200&q=80","description":"A pink-themed cafe hidden behind a vending machine door in the backstreets of Mangwon.","address":"400-2 Mangwon-dong, Mapo-gu","nearestMetro":"Mangwon (Line 6)","priceLevel":"₩₩","openingHours":"11 AM – 10 PM","overview":"Zapangi went viral for its entrance — a vending machine door that swings open to reveal a dreamy pink interior. But beyond the Instagram aesthetics, the mermaid cream cakes and specialty drinks are genuinely excellent.","whyVisit":"The entrance alone makes it worth the visit, but the mermaid cream cakes are some of the most photogenic (and tastiest) desserts in Seoul. It's a perfect example of Korea's creative cafe culture.","tips":["The vending machine IS the door — push it open.","The mermaid cream cake is the must-order.","Weekday afternoons are the quietest times."],"lat":37.5567,"lng":126.9097,"contentType":"venue"},{"slug":"mowmow-hongdae","name":"Mowmow","citySlug":"seoul","neighbourhoodSlug":"hongdae","category":"bar","image":"https://images.unsplash.com/photo-1572116469696-31de0f17cc34?w=1200&q=80","description":"Cozy cocktail bar with creative drinks and a relaxed Hongdae vibe.","address":"Wausan-ro 29na-gil, Mapo-gu","nearestMetro":"Hongik University (Line 2)","priceLevel":"₩₩","openingHours":"6 PM – 2 AM","overview":"Small bar known for inventive cocktails.","whyVisit":"Friendly staff and unique menu.","tips":[],"lat":37.5565,"lng":126.924,"contentType":"venue"},{"slug":"soap-seoul","name":"Soap Seoul","citySlug":"seoul","neighbourhoodSlug":"hongdae","category":"bar","image":"https://images.unsplash.com/photo-1525268323446-0505b6fe7778?w=1200&q=80","description":"Craft beer and soju cocktails in a laid-back space.","address":"Wausan-ro 21-gil, Mapo-gu","nearestMetro":"Hongik University (Line 2)","priceLevel":"₩₩","openingHours":"5 PM – 1 AM","overview":"Beer-focused bar with Korean and international brews.","whyVisit":"Great selection and atmosphere.","tips":[],"lat":37.5558,"lng":126.9225,"contentType":"venue"},{"slug":"hongdae-gogung","name":"Gogung Hongdae","citySlug":"seoul","neighbourhoodSlug":"hongdae","category":"restaurant","image":"https://images.unsplash.com/photo-1590301157890-4810ed352733?w=1200&q=80","description":"Traditional bibimbap and Korean classics in a casual setting.","address":"Wausan-ro 29-gil, Mapo-gu","nearestMetro":"Hongik University (Line 2)","priceLevel":"₩₩","openingHours":"11 AM – 9 PM","overview":"Popular spot for bibimbap.","whyVisit":"Authentic and affordable.","tips":[],"lat":37.556,"lng":126.9238,"contentType":"venue"},{"slug":"maple-tree-house-hongdae","name":"Maple Tree House Hongdae","citySlug":"seoul","neighbourhoodSlug":"hongdae","category":"restaurant","image":"https://images.unsplash.com/photo-1590301157890-4810ed352733?w=1200&q=80","description":"Korean BBQ with quality meats and efficient service.","address":"Yanghwa-ro 16-gil, Mapo-gu","nearestMetro":"Hongik University (Line 2)","priceLevel":"₩₩₩","openingHours":"12 PM – 10 PM","overview":"Well-loved BBQ chain in Hongdae.","whyVisit":"Consistent quality.","tips":[],"lat":37.557,"lng":126.925,"contentType":"venue"},{"slug":"hongdae-tteokbokki","name":"Hongdae Tteokbokki Alley","citySlug":"seoul","neighbourhoodSlug":"hongdae","category":"restaurant","image":"https://images.unsplash.com/photo-1498654896293-37aacf113fd9?w=1200&q=80","description":"Street food stalls and small joints serving spicy tteokbokki.","address":"Near Hongik University Station","nearestMetro":"Hongik University (Line 2)","priceLevel":"₩","openingHours":"11 AM – 10 PM","overview":"Classic student-area tteokbokki.","whyVisit":"Cheap and filling.","tips":[],"lat":37.5562,"lng":126.9245,"contentType":"venue"},{"slug":"cafe-extent-hongdae","name":"Cafe Extent","citySlug":"seoul","neighbourhoodSlug":"hongdae","category":"cafe","image":"https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=1200&q=80","description":"Specialty coffee and minimal interior.","address":"Wausan-ro 21-gil, Mapo-gu","nearestMetro":"Hongik University (Line 2)","priceLevel":"₩₩","openingHours":"10 AM – 8 PM","overview":"Quiet cafe for coffee and work.","whyVisit":"Good beans and calm space.","tips":[],"lat":37.5555,"lng":126.923,"contentType":"venue"},{"slug":"thanks-nature-hongdae","name":"Thanks Nature Cafe","citySlug":"seoul","neighbourhoodSlug":"hongdae","category":"cafe","image":"https: